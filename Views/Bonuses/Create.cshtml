@model WorkFlowManager.ViewModels.CreateBonusViewModel

@{
    ViewData["Title"] = "Add Bonus";
}

<h2><i class="bi bi-gift me-2"></i>Add New Bonus</h2>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label asp-for="UserId" class="form-label"></label>
                        <select asp-for="UserId" class="form-select" asp-items="Model.Users">
                            <option value="">-- Select Employee --</option>
                        </select>
                        <span asp-validation-for="UserId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Amount" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" />
                            <span class="input-group-text">PLN</span>
                        </div>
                        <span asp-validation-for="Amount" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DateGranted" class="form-label"></label>
                        <input asp-for="DateGranted" class="form-control" type="date" />
                        <span asp-validation-for="DateGranted" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Reason" class="form-label"></label>
                        <textarea asp-for="Reason" class="form-control" rows="3" placeholder="Enter reason for this bonus..."></textarea>
                        <span asp-validation-for="Reason" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Add Bonus
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card bg-light">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-info-circle me-2"></i>Information</h5>
                <p class="card-text">
                    Bonuses are additional payments granted to employees for exceptional performance, 
                    achievements, or other reasons.
                </p>
                <hr />
                <p class="card-text text-muted small">
                    <strong>Note:</strong> Bonuses will be included in the employee's payroll calculation 
                    for the month in which they were granted.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


@model WorkFlowManager.Models.Bonus

@{
    ViewData["Title"] = "Delete Bonus";
}

<h2><i class="bi bi-trash me-2 text-danger"></i>Delete Bonus</h2>

<div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle me-2"></i>
    <strong>Warning!</strong> Are you sure you want to delete this bonus? This action cannot be undone.
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-danger text-white">
                <strong>Bonus #@Model.Id</strong>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Employee</dt>
                    <dd class="col-sm-8">@Model.User?.FirstName @Model.User?.LastName</dd>

                    <dt class="col-sm-4">Amount</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-success">@Model.Amount.ToString("N2") PLN</span>
                    </dd>

                    <dt class="col-sm-4">Date Granted</dt>
                    <dd class="col-sm-8">@Model.DateGranted.ToString("dd MMM yyyy")</dd>

                    <dt class="col-sm-4">Reason</dt>
                    <dd class="col-sm-8">@Model.Reason</dd>
                </dl>
            </div>
            <div class="card-footer">
                <form asp-action="Delete" method="post">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i>Delete Bonus
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


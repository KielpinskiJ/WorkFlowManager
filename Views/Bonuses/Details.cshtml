@model WorkFlowManager.Models.Bonus

@{
    ViewData["Title"] = "Bonus Details";
}

<div class="page-header">
    <h1><i class="bi bi-gift-fill"></i>Bonus Details</h1>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card-custom">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-hash me-1"></i>Bonus #@Model.Id</h5>
                <span class="badge-custom-success" style="font-size: 1rem;">@Model.Amount.ToString("N2") zł</span>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold" style="color: #64748b;">
                        <i class="bi bi-person-fill me-1"></i>Employee
                    </label>
                    <p class="mb-0">
                        <strong style="color: #1e293b;">@Model.User?.FirstName @Model.User?.LastName</strong>
                        <span class="d-block small" style="color: #64748b;">@Model.User?.Email</span>
                    </p>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold" style="color: #64748b;">
                        <i class="bi bi-currency-exchange me-1"></i>Amount
                    </label>
                    <p class="mb-0" style="color: #1e293b;">@Model.Amount.ToString("N2") zł</p>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold" style="color: #64748b;">
                        <i class="bi bi-calendar-fill me-1"></i>Date Granted
                    </label>
                    <p class="mb-0" style="color: #1e293b;">@Model.DateGranted.ToString("dddd, dd MMMM yyyy")</p>
                </div>

                <div>
                    <label class="form-label fw-semibold" style="color: #64748b;">
                        <i class="bi bi-card-text me-1"></i>Reason
                    </label>
                    <p class="mb-0" style="color: #1e293b;">@Model.Reason</p>
                </div>
            </div>
            <div class="card-footer d-flex gap-2">
                <a asp-action="Index" class="btn btn-custom-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Back to List
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-custom-danger">
                    <i class="bi bi-trash-fill me-1"></i>Delete
                </a>
            </div>
        </div>
    </div>
</div>

@model IEnumerable<WorkFlowManager.Models.Bonus>

@{
    ViewData["Title"] = "Bonuses";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-gift me-2"></i>Employee Bonuses</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Add Bonus
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>No bonuses have been granted yet.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Employee</th>
                    <th>Amount</th>
                    <th>Date Granted</th>
                    <th>Reason</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bonus in Model)
                {
                    <tr>
                        <td>
                            <strong>@bonus.User?.FirstName @bonus.User?.LastName</strong>
                            <br /><small class="text-muted">@bonus.User?.Email</small>
                        </td>
                        <td>
                            <span class="badge bg-success fs-6">
                                @bonus.Amount.ToString("N2") PLN
                            </span>
                        </td>
                        <td>@bonus.DateGranted.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (bonus.Reason.Length > 50)
                            {
                                @(bonus.Reason.Substring(0, 50))@("...")
                            }
                            else
                            {
                                @bonus.Reason
                            }
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="Details" asp-route-id="@bonus.Id" class="btn btn-sm btn-outline-primary" title="Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@bonus.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    <div class="card bg-light mt-4">
        <div class="card-body">
            <div class="row text-center">
                <div class="col-md-4">
                    <h5 class="text-muted">Total Bonuses</h5>
                    <h3 class="text-success">@Model.Sum(b => b.Amount).ToString("N2") PLN</h3>
                </div>
                <div class="col-md-4">
                    <h5 class="text-muted">Bonuses Count</h5>
                    <h3>@Model.Count()</h3>
                </div>
                <div class="col-md-4">
                    <h5 class="text-muted">Average Bonus</h5>
                    <h3>@(Model.Any() ? Model.Average(b => b.Amount).ToString("N2") : "0.00") PLN</h3>
                </div>
            </div>
        </div>
    </div>
}


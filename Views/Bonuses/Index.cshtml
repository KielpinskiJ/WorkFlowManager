@model IEnumerable<WorkFlowManager.Models.Bonus>

@{
    ViewData["Title"] = "Bonuses";
}

<div class="page-header">
    <h1><i class="bi bi-gift-fill"></i>Employee Bonuses</h1>
    <a asp-action="Create" class="btn btn-custom-primary">
        <i class="bi bi-plus-lg me-1"></i><span class="d-none d-sm-inline">Add </span>Bonus
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert-custom-success mb-4">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
    </div>
}

@if (!Model.Any())
{
    <div class="alert-custom-info">
        <i class="bi bi-info-circle-fill me-2"></i>No bonuses have been granted yet.
    </div>
}
else
{
    <div class="table-responsive">
        <div class="table-wrapper">
            <table class="table table-custom mb-0">
                <thead>
                    <tr>
                        <th><i class="bi bi-person-fill me-1"></i>Employee</th>
                        <th><i class="bi bi-currency-exchange me-1"></i>Amount</th>
                        <th class="d-none d-md-table-cell"><i class="bi bi-calendar-fill me-1"></i>Date</th>
                        <th class="d-none d-lg-table-cell"><i class="bi bi-card-text me-1"></i>Reason</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bonus in Model)
                    {
                        <tr>
                            <td>
                                <strong style="color: #1e293b;">@bonus.User?.FirstName @bonus.User?.LastName</strong>
                                <span class="d-block small" style="color: #64748b;">@bonus.User?.Email</span>
                            </td>
                            <td>
                                <span class="badge-custom-success">@bonus.Amount.ToString("N2") zł</span>
                            </td>
                            <td class="d-none d-md-table-cell" style="color: #475569;">@bonus.DateGranted.ToString("dd MMM yyyy")</td>
                            <td class="d-none d-lg-table-cell" style="color: #475569;">
                                @if (bonus.Reason.Length > 50)
                                {
                                    @(bonus.Reason.Substring(0, 50))@("...")
                                }
                                else
                                {
                                    @bonus.Reason
                                }
                            </td>
                            <td class="text-end" style="white-space: nowrap;">
                                <a asp-action="Details" asp-route-id="@bonus.Id" class="btn btn-custom-info btn-custom-sm" title="Details">
                                    <i class="bi bi-eye-fill"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@bonus.Id" class="btn btn-custom-danger btn-custom-sm" title="Delete">
                                    <i class="bi bi-trash-fill"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    <div class="card-custom mt-4">
        <div class="card-body">
            <div class="row text-center">
                <div class="col-md-4 mb-3 mb-md-0">
                    <h5 style="color: #64748b;" class="mb-1">Total Bonuses</h5>
                    <span class="fs-3 fw-bold" style="color: #22c55e;">@Model.Sum(b => b.Amount).ToString("N2") zł</span>
                </div>
                <div class="col-md-4 mb-3 mb-md-0">
                    <h5 style="color: #64748b;" class="mb-1">Bonuses Count</h5>
                    <span class="fs-3 fw-bold" style="color: #1e293b;">@Model.Count()</span>
                </div>
                <div class="col-md-4">
                    <h5 style="color: #64748b;" class="mb-1">Average Bonus</h5>
                    <span class="fs-3 fw-bold" style="color: #3b82f6;">@(Model.Any() ? Model.Average(b => b.Amount).ToString("N2") : "0.00") zł</span>
                </div>
            </div>
        </div>
    </div>
}

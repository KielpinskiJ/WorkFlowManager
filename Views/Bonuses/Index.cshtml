@model IEnumerable<WorkFlowManager.Models.Bonus>
@inject IHtmlLocalizer<SharedResource> L

@{
    ViewData["Title"] = L["Bonuses"].Value;
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var pageSize = (int)(ViewBag.PageSize ?? 10);
    var totalBonusAmount = (decimal)(ViewBag.TotalBonusAmount ?? 0m);
    var bonusCount = (int)(ViewBag.BonusCount ?? 0);
    var avgBonusAmount = (decimal)(ViewBag.AvgBonusAmount ?? 0m);
}

<div class="page-header">
    <h1><i class="bi bi-gift-fill"></i>@L["EmployeeBonuses"]</h1>
    <a asp-action="Create" class="btn btn-custom-primary">
        <i class="bi bi-plus-lg me-1"></i><span class="d-none d-sm-inline">@L["AddBonus"]</span>
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert-custom-success mb-4">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
    </div>
}

@if (!Model.Any())
{
    <div class="alert-custom-info">
        <i class="bi bi-info-circle-fill me-2"></i>@L["NoBonusesYet"]
    </div>
}
else
{
    <div class="table-responsive">
        <div class="table-wrapper">
            <table class="table table-custom mb-0">
                <thead>
                    <tr>
                        <th><i class="bi bi-person-fill me-1"></i>@L["Employee"]</th>
                        <th><i class="bi bi-currency-exchange me-1"></i>@L["Amount"]</th>
                        <th class="d-none d-md-table-cell"><i class="bi bi-calendar-fill me-1"></i>@L["Date"]</th>
                        <th class="d-none d-lg-table-cell"><i class="bi bi-card-text me-1"></i>@L["Reason"]</th>
                        <th class="text-end">@L["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bonus in Model)
                    {
                        <tr>
                            <td>
                                <strong style="color: #1e293b;">@bonus.User?.FirstName @bonus.User?.LastName</strong>
                                <span class="d-block small" style="color: #64748b;">@bonus.User?.Email</span>
                            </td>
                            <td>
                                <span class="badge-custom-success">@bonus.Amount.ToString("N2") zł</span>
                            </td>
                            <td class="d-none d-md-table-cell" style="color: #475569;">@bonus.DateGranted.ToString("dd MMM yyyy")</td>
                            <td class="d-none d-lg-table-cell" style="color: #475569;">
                                @if (bonus.Reason.Length > 50)
                                {
                                    @(bonus.Reason.Substring(0, 50))@("...")
                                }
                                else
                                {
                                    @bonus.Reason
                                }
                            </td>
                            <td class="text-end" style="white-space: nowrap;">
                                <a asp-action="Details" asp-route-id="@bonus.Id" class="btn btn-custom-info btn-custom-sm" title="@L["Details"]">
                                    <i class="bi bi-eye-fill"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@bonus.Id" class="btn btn-custom-danger btn-custom-sm" title="@L["Delete"]">
                                    <i class="bi bi-trash-fill"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    @if (totalPages > 1)
    {
        <nav aria-label="Bonuses pagination" class="my-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span class="text-muted small">
                    Showing @((currentPage - 1) * pageSize + 1)-@(Math.Min(currentPage * pageSize, totalCount)) of @totalCount bonuses
                </span>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    @{
                        var startPage = Math.Max(1, currentPage - 2);
                        var endPage = Math.Min(totalPages, currentPage + 2);
                        
                        if (startPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index" asp-route-page="1">1</a>
                            </li>
                            if (startPage > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }
                    }
                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                        </li>
                    }
                    @if (endPage < totalPages)
                    {
                        if (endPage < totalPages - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-page="@totalPages">@totalPages</a>
                        </li>
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </div>
        </nav>
    }
    
    <div class="card-custom mt-4">
        <div class="card-body">
            <div class="row text-center">
                <div class="col-md-4 mb-3 mb-md-0">
                    <h5 style="color: #64748b;" class="mb-1">@L["TotalBonuses"]</h5>
                    <span class="fs-3 fw-bold" style="color: #22c55e;">@totalBonusAmount.ToString("N2") zł</span>
                </div>
                <div class="col-md-4 mb-3 mb-md-0">
                    <h5 style="color: #64748b;" class="mb-1">@L["BonusesCount"]</h5>
                    <span class="fs-3 fw-bold" style="color: #1e293b;">@bonusCount</span>
                </div>
                <div class="col-md-4">
                    <h5 style="color: #64748b;" class="mb-1">@L["AverageBonus"]</h5>
                    <span class="fs-3 fw-bold" style="color: #3b82f6;">@avgBonusAmount.ToString("N2") zł</span>
                </div>
            </div>
        </div>
    </div>
}

@model WorkFlowManager.Models.Department

@{
    ViewData["Title"] = "Delete Department";
}

<h1>Delete Department</h1>

<div class="alert alert-warning">
    <strong>Warning!</strong> Are you sure you want to delete this department? This action cannot be undone.
</div>

<div class="card" style="max-width: 500px;">
    <div class="card-body">
        <h5 class="card-title">@Model.Name</h5>
        <p class="card-text">
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                @Model.Description
            }
            else
            {
                <span class="text-muted">No description</span>
            }
        </p>
        <p class="card-text">
            <strong>Hourly Rate:</strong> 
            <span class="badge bg-success">@Model.HourlyRate.ToString("N2") zł/h</span>
        </p>
        
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

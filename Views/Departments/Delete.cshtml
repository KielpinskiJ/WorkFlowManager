@model WorkFlowManager.Models.Department

@{
    ViewData["Title"] = "Delete Department";
}

<div class="page-header">
    <h1><i class="bi bi-trash-fill"></i>Delete Department</h1>
</div>

<div class="alert-custom-warning mb-4">
    <i class="bi bi-exclamation-triangle-fill me-2"></i>
    <strong>Warning!</strong> Are you sure you want to delete this department? This action cannot be undone.
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card-custom">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-building-fill me-2"></i>@Model.Name</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold" style="color: #64748b;">
                        <i class="bi bi-card-text me-1"></i>Description
                    </label>
                    <p class="mb-0" style="color: #1e293b;">
                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            @Model.Description
                        }
                        else
                        {
                            <span style="color: #94a3b8;">No description</span>
                        }
                    </p>
                </div>
                <div>
                    <label class="form-label fw-semibold" style="color: #64748b;">
                        <i class="bi bi-currency-exchange me-1"></i>Hourly Rate
                    </label>
                    <p class="mb-0">
                        <span class="badge-custom-success">@Model.HourlyRate.ToString("N2") zł/h</span>
                    </p>
                </div>
            </div>
            <div class="card-footer d-flex gap-2">
                <form asp-action="Delete" class="d-flex gap-2 mb-0">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-custom-danger">
                        <i class="bi bi-trash-fill me-1"></i>Delete
                    </button>
                    <a asp-action="Index" class="btn btn-custom-secondary">
                        <i class="bi bi-x-lg me-1"></i>Cancel
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>

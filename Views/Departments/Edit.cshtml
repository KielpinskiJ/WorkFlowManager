@model WorkFlowManager.Models.Department

@{
    ViewData["Title"] = "Edit Department";
}

<div class="page-header">
    <h1><i class="bi bi-pencil-fill"></i>Edit Department</h1>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="form-custom">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="alert-custom-danger mb-3" role="alert"></div>
                
                <input type="hidden" asp-for="Id" />
                
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold" style="color: #374151;">
                        <i class="bi bi-tag-fill me-1" style="color: #3b82f6;"></i>Department Name
                    </label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                
                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold" style="color: #374151;">
                        <i class="bi bi-card-text me-1" style="color: #3b82f6;"></i>Description
                    </label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                
                <div class="mb-4">
                    <label asp-for="HourlyRate" class="form-label fw-semibold" style="color: #374151;">
                        <i class="bi bi-currency-exchange me-1" style="color: #3b82f6;"></i>Hourly Rate
                    </label>
                    <div class="input-group">
                        <input asp-for="HourlyRate" class="form-control" type="number" step="0.01" min="0.01" />
                        <span class="input-group-text">zł/h</span>
                    </div>
                    <span asp-validation-for="HourlyRate" class="text-danger small"></span>
                </div>
                
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-custom-primary">
                        <i class="bi bi-check-lg me-1"></i>Save Changes
                    </button>
                    <a asp-action="Index" class="btn btn-custom-secondary">
                        <i class="bi bi-x-lg me-1"></i>Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

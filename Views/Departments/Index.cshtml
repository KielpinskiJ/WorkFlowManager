@model IEnumerable<WorkFlowManager.Models.Department>
@inject IHtmlLocalizer<SharedResource> L

@{
    ViewData["Title"] = L["Departments"].Value;
    var userDepartmentId = ViewBag.UserDepartmentId as int?;
    var isAdmin = ViewBag.IsAdmin as bool? ?? false;
}

<div class="page-header">
    <h1><i class="bi bi-building-fill"></i>@L["Departments"]</h1>
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-custom-primary">
            <i class="bi bi-plus-lg me-1"></i><span class="d-none d-sm-inline">@L["AddDepartment"]</span>
        </a>
    }
</div>

@if (userDepartmentId.HasValue && !isAdmin)
{
    var myDepartment = Model.FirstOrDefault(d => d.Id == userDepartmentId.Value);
    if (myDepartment != null)
    {
        <div class="alert-custom-info mb-4">
            <i class="bi bi-info-circle-fill me-2"></i>
            <strong>@L["YourDepartment"]:</strong> @myDepartment.Name
            @if (!string.IsNullOrEmpty(myDepartment.Description))
            {
                <span class="text-muted">— @myDepartment.Description</span>
            }
        </div>
    }
}

@if (TempData["Success"] != null)
{
    <div class="alert-custom-success mb-4">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert-custom-danger mb-4">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["Error"]
    </div>
}

@if (!Model.Any())
{
    <div class="alert-custom-info">
        <i class="bi bi-info-circle-fill me-2"></i>
        <strong>@L["NoDepartmentsFound"]</strong>
        @if (isAdmin)
        {
            <span>@L["CreateFirstDepartment"]</span>
        }
    </div>
}
else
{
    <div class="table-responsive">
        <div class="table-wrapper">
            <table class="table table-custom mb-0">
                <thead>
                    <tr>
                        <th><i class="bi bi-tag-fill me-1"></i>@L["Name"]</th>
                        <th class="d-none d-md-table-cell"><i class="bi bi-card-text me-1"></i>@L["Description"]</th>
                        @if (isAdmin)
                        {
                            <th><i class="bi bi-currency-exchange me-1"></i>@L["Rate"]</th>
                            <th class="text-end">@L["Actions"]</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var isMyDepartment = userDepartmentId.HasValue && item.Id == userDepartmentId.Value;
                        <tr class="@(isMyDepartment ? "table-highlight" : "")">
                            <td>
                                <strong>@item.Name</strong>
                                @if (isMyDepartment)
                                {
                                    <span class="badge-custom ms-2 d-none d-sm-inline-block">@L["YourDept"]</span>
                                    <span class="badge-custom d-sm-none d-block mt-1" style="font-size: 0.7em;">@L["YourDept"]</span>
                                }
                            </td>
                            <td class="d-none d-md-table-cell text-secondary">
                                @(string.IsNullOrEmpty(item.Description) ? "—" : item.Description)
                            </td>
                            @if (isAdmin)
                            {
                                <td>
                                    <span class="badge-custom-success">@item.HourlyRate.ToString("N2") zł</span>
                                </td>
                                <td class="text-end" style="white-space: nowrap;">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-custom-info btn-custom-sm" title="@L["Details"]">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-custom-warning btn-custom-sm" title="@L["Edit"]">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-custom-danger btn-custom-sm" title="@L["Delete"]">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

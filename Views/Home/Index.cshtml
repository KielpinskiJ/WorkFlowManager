@inject IHtmlLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["Home"].Value;
}

<div class="text-center py-5">
    <div class="mb-4">
        <i class="bi bi-kanban-fill" style="font-size: 4rem; color: #3b82f6;"></i>
    </div>
    <h1 class="display-4 mb-3" style="color: #1e293b; font-weight: 600;">@L["WelcomeTitle"]</h1>
    <p class="lead mb-4" style="color: #64748b;">
        @L["HomeSubtitle"]
    </p>
    
    @if (!User.Identity?.IsAuthenticated ?? true)
    {
        <div class="d-flex justify-content-center gap-3 mb-5">
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-custom-primary btn-lg">
                <i class="bi bi-box-arrow-in-right me-2"></i>@L["Login"]
            </a>
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-custom-secondary btn-lg">
                <i class="bi bi-person-plus me-2"></i>@L["Register"]
            </a>
        </div>
    }
    else
    {
        <div class="mb-5">
            <a asp-controller="Departments" asp-action="Index" class="btn btn-custom-primary btn-lg">
                <i class="bi bi-arrow-right-circle me-2"></i>@L["GoToDepartments"]
            </a>
        </div>
    }
</div>

<div class="row g-4 mt-2">
    <div class="col-md-4">
        <div class="card-custom h-100">
            <div class="card-body text-center py-4">
                <i class="bi bi-building-fill fs-1 mb-3" style="color: #3b82f6;"></i>
                <h5 style="color: #1e293b;">@L["Departments"]</h5>
                <p style="color: #64748b;">@L["DepartmentsDescription"]</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-custom h-100">
            <div class="card-body text-center py-4">
                <i class="bi bi-calendar-week-fill fs-1 mb-3" style="color: #22c55e;"></i>
                <h5 style="color: #1e293b;">@L["Scheduling"]</h5>
                <p style="color: #64748b;">@L["SchedulingDescription"]</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-custom h-100">
            <div class="card-body text-center py-4">
                <i class="bi bi-cash-stack fs-1 mb-3" style="color: #f59e0b;"></i>
                <h5 style="color: #1e293b;">@L["Payroll"]</h5>
                <p style="color: #64748b;">@L["PayrollDescription"]</p>
            </div>
        </div>
    </div>
</div>

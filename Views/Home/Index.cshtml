@{
    ViewData["Title"] = "Home";
}

<div class="text-center py-5">
    <div class="mb-4">
        <i class="bi bi-kanban-fill" style="font-size: 4rem; color: #3b82f6;"></i>
    </div>
    <h1 class="display-4 mb-3" style="color: #1e293b; font-weight: 600;">Welcome to WorkFlowManager</h1>
    <p class="lead mb-4" style="color: #64748b;">
        Manage employees, schedules, requests, and payroll - all in one place.
    </p>
    
    @if (!User.Identity?.IsAuthenticated ?? true)
    {
        <div class="d-flex justify-content-center gap-3 mb-5">
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-custom-primary btn-lg">
                <i class="bi bi-box-arrow-in-right me-2"></i>Login
            </a>
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-custom-secondary btn-lg">
                <i class="bi bi-person-plus me-2"></i>Register
            </a>
        </div>
    }
    else
    {
        <div class="mb-5">
            <a asp-controller="Departments" asp-action="Index" class="btn btn-custom-primary btn-lg">
                <i class="bi bi-arrow-right-circle me-2"></i>Go to Departments
            </a>
        </div>
    }
</div>

<div class="row g-4 mt-2">
    <div class="col-md-4">
        <div class="card-custom h-100">
            <div class="card-body text-center py-4">
                <i class="bi bi-building-fill fs-1 mb-3" style="color: #3b82f6;"></i>
                <h5 style="color: #1e293b;">Departments</h5>
                <p style="color: #64748b;">Organize employees into departments with customizable hourly rates.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-custom h-100">
            <div class="card-body text-center py-4">
                <i class="bi bi-calendar-week-fill fs-1 mb-3" style="color: #22c55e;"></i>
                <h5 style="color: #1e293b;">Scheduling</h5>
                <p style="color: #64748b;">Create and manage work shifts. Employees can view their schedules easily.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-custom h-100">
            <div class="card-body text-center py-4">
                <i class="bi bi-cash-stack fs-1 mb-3" style="color: #f59e0b;"></i>
                <h5 style="color: #1e293b;">Payroll</h5>
                <p style="color: #64748b;">Automatic payroll calculation based on hours worked and bonuses.</p>
            </div>
        </div>
    </div>
</div>

@model WorkFlowManager.ViewModels.PayrollReportViewModel

@{
    ViewData["Title"] = "Payroll Report";
}

<style>
    @@media print {
        .no-print {
            display: none !important;
        }
        header, footer, .navbar {
            display: none !important;
        }
        .container {
            max-width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
        }
        .card {
            border: none !important;
            box-shadow: none !important;
        }
        .card-header {
            background-color: #333 !important;
            color: white !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }
        body {
            font-size: 11px;
            padding: 10px;
        }
        .table {
            font-size: 10px;
        }
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4 no-print">
    <h2><i class="bi bi-cash-stack me-2"></i>Payroll Report</h2>
    <button onclick="window.print()" class="btn btn-outline-secondary">
        <i class="bi bi-printer me-1"></i>Print Report
    </button>
</div>

<!-- Month/Year Selector -->
<div class="card mb-4 no-print">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Month</label>
                <select name="month" class="form-select">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(m == Model.Month)">
                            @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Year</label>
                <select name="year" class="form-select">
                    @foreach (var y in (List<int>)ViewBag.AvailableYears)
                    {
                        <option value="@y" selected="@(y == Model.Year)">@y</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search me-1"></i>Generate Report
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Report Header -->
<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <div class="row">
            <div class="col">
                <h4 class="mb-0">
                    <i class="bi bi-file-earmark-spreadsheet me-2"></i>
                    @Model.MonthName @Model.Year - Payroll Summary
                </h4>
            </div>
            <div class="col-auto">
                <small>Generated: @Model.GeneratedAt.ToString("dd MMM yyyy, HH:mm")</small>
            </div>
        </div>
    </div>
    <div class="card-body">
        @if (!Model.Entries.Any())
        {
            <div class="alert alert-info mb-0">
                <i class="bi bi-info-circle me-2"></i>
                No payroll data available for @Model.MonthName @Model.Year.
                Employees need assigned shifts and/or bonuses in this period.
            </div>
        }
        else
        {
            <!-- Summary Cards -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h6 class="text-muted">Total Employees</h6>
                            <h3 class="text-primary">@Model.EmployeeCount</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h6 class="text-muted">Total Hours</h6>
                            <h3 class="text-info">@Model.TotalHours.ToString("N1") h</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h6 class="text-muted">Total Bonuses</h6>
                            <h3 class="text-warning">@Model.TotalBonuses.ToString("N2") PLN</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-success text-white">
                        <div class="card-body text-center">
                            <h6>Total Payroll</h6>
                            <h3>@Model.TotalPayroll.ToString("N2") PLN</h3>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Payroll Table -->
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Employee</th>
                            <th>Department</th>
                            <th class="text-end">Rate/h</th>
                            <th class="text-end">Hours</th>
                            <th class="text-end">Base Pay</th>
                            <th class="text-end">Bonuses</th>
                            <th class="text-end"><strong>Total</strong></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.Entries)
                        {
                            <tr>
                                <td>
                                    <strong>@entry.FullName</strong>
                                    <br /><small class="text-muted">@entry.Email</small>
                                </td>
                                <td>
                                    @if (entry.DepartmentName == "Unassigned")
                                    {
                                        <span class="badge bg-secondary">@entry.DepartmentName</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info">@entry.DepartmentName</span>
                                    }
                                </td>
                                <td class="text-end">@entry.HourlyRate.ToString("N2") PLN</td>
                                <td class="text-end">@entry.TotalHours.ToString("N1") h</td>
                                <td class="text-end">@entry.BasePayment.ToString("N2") PLN</td>
                                <td class="text-end">
                                    @if (entry.BonusTotal > 0)
                                    {
                                        <span class="text-success">+@entry.BonusTotal.ToString("N2") PLN</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0.00 PLN</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <strong class="text-primary">@entry.FinalSalary.ToString("N2") PLN</strong>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-secondary">
                        <tr>
                            <th colspan="3">TOTAL</th>
                            <th class="text-end">@Model.TotalHours.ToString("N1") h</th>
                            <th class="text-end">@Model.Entries.Sum(e => e.BasePayment).ToString("N2") PLN</th>
                            <th class="text-end">@Model.TotalBonuses.ToString("N2") PLN</th>
                            <th class="text-end text-success fs-5">@Model.TotalPayroll.ToString("N2") PLN</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
</div>



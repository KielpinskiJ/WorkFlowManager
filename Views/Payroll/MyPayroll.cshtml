@model WorkFlowManager.ViewModels.PayrollEntryViewModel

@{
    ViewData["Title"] = "My Payroll";
    var month = (int)ViewBag.Month;
    var year = (int)ViewBag.Year;
    var monthName = (string)ViewBag.MonthName;
}

<div class="page-header">
    <h1><i class="bi bi-wallet2"></i>My Payroll</h1>
</div>

<!-- Month/Year Selector -->
<div class="form-custom mb-4">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label fw-semibold" style="color: #374151;">
                <i class="bi bi-calendar-month me-1" style="color: #3b82f6;"></i>Month
            </label>
            <select name="month" class="form-select">
                @for (int m = 1; m <= 12; m++)
                {
                    <option value="@m" selected="@(m == month)">
                        @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)
                    </option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label fw-semibold" style="color: #374151;">
                <i class="bi bi-calendar-fill me-1" style="color: #3b82f6;"></i>Year
            </label>
            <select name="year" class="form-select">
                @foreach (var y in (List<int>)ViewBag.AvailableYears)
                {
                    <option value="@y" selected="@(y == year)">@y</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-custom-primary">
                <i class="bi bi-search me-1"></i>View Payroll
            </button>
        </div>
    </form>
</div>

@if (Model == null)
{
    <div class="alert-custom-info">
        <i class="bi bi-info-circle-fill me-2"></i>
        No payroll data available for @monthName @year.
    </div>
}
else
{
    <div class="row">
        <div class="col-lg-8 mb-4 mb-lg-0">
            <div class="card-custom">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-file-earmark-text-fill me-2"></i>
                        Payroll Statement - @monthName @year
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <label class="form-label fw-semibold" style="color: #64748b;">
                                <i class="bi bi-person-fill me-1"></i>Employee
                            </label>
                            <p class="fs-5 mb-0"><strong style="color: #1e293b;">@Model.FullName</strong></p>
                            <small style="color: #64748b;">@Model.Email</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="color: #64748b;">
                                <i class="bi bi-building-fill me-1"></i>Department
                            </label>
                            <p class="fs-5 mb-0">
                                @if (Model.DepartmentName == "Unassigned")
                                {
                                    <span class="badge-custom">@Model.DepartmentName</span>
                                }
                                else
                                {
                                    <span class="badge-custom-info" style="font-size: 1rem;">@Model.DepartmentName</span>
                                }
                            </p>
                        </div>
                    </div>

                    <hr style="border-color: #e2e8f0;" />

                    <table class="table table-borderless mb-0">
                        <tbody>
                            <tr>
                                <td style="color: #64748b;"><i class="bi bi-currency-exchange me-2"></i>Hourly Rate</td>
                                <td class="text-end" style="color: #1e293b;">@Model.HourlyRate.ToString("N2") zł/h</td>
                            </tr>
                            <tr>
                                <td style="color: #64748b;"><i class="bi bi-clock me-2"></i>Hours Worked</td>
                                <td class="text-end" style="color: #1e293b;">@Model.TotalHours.ToString("N1") h</td>
                            </tr>
                            <tr>
                                <td style="color: #64748b;"><i class="bi bi-wallet2 me-2"></i>Base Payment</td>
                                <td class="text-end" style="color: #1e293b;">@Model.BasePayment.ToString("N2") zł</td>
                            </tr>
                            <tr>
                                <td style="color: #64748b;"><i class="bi bi-gift me-2"></i>Bonuses</td>
                                <td class="text-end">
                                    @if (Model.BonusTotal > 0)
                                    {
                                        <span style="color: #22c55e;">+@Model.BonusTotal.ToString("N2") zł</span>
                                    }
                                    else
                                    {
                                        <span style="color: #1e293b;">0.00 zł</span>
                                    }
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr style="border-top: 2px solid #e2e8f0;">
                                <th class="fs-5" style="color: #1e293b;"><i class="bi bi-cash-coin me-2"></i>Total Salary</th>
                                <th class="text-end fs-4" style="color: #22c55e;">@Model.FinalSalary.ToString("N2") zł</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card-custom card-highlight text-center" style="background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);">
                <div class="card-body text-white py-4">
                    <i class="bi bi-cash-coin" style="font-size: 3rem;"></i>
                    <h4 class="mt-3 mb-1">@Model.FinalSalary.ToString("N2") zł</h4>
                    <p class="mb-0 opacity-75">Total for @monthName @year</p>
                </div>
            </div>

            @if (Model.TotalHours == 0 && Model.BonusTotal == 0)
            {
                <div class="alert-custom-warning mt-3">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <small>No shifts or bonuses recorded for this month.</small>
                </div>
            }
        </div>
    </div>
}

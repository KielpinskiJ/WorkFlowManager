@model WorkFlowManager.ViewModels.CreateRequestViewModel
@inject IHtmlLocalizer<SharedResource> L

@{
    ViewData["Title"] = L["SubmitRequest"].Value;
}

<div class="page-header">
    <h1><i class="bi bi-plus-circle-fill"></i>@L["SubmitRequest"]</h1>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="form-custom">
            <form asp-action="Create" method="post">
                @if (ViewData.ModelState.TryGetValue(string.Empty, out var entry) && entry.Errors.Count > 0)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        @foreach (var error in entry.Errors)
                        {
                            <span>@error.ErrorMessage</span>
                        }
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                
                <div class="mb-3">
                    <label asp-for="Type" class="form-label fw-semibold" style="color: #374151;">
                        <i class="bi bi-tag-fill me-1" style="color: #3b82f6;"></i>@L["RequestType"]
                    </label>
                    <select asp-for="Type" class="form-select" id="requestType" asp-items="Html.GetEnumSelectList<WorkFlowManager.Models.RequestType>()">
                        <option value="">@L["SelectType"]</option>
                    </select>
                    <span asp-validation-for="Type" class="text-danger small"></span>
                </div>

                <!-- Vacation fields (dates) -->
                <div id="vacationFields">
                    <div class="mb-3">
                        <label asp-for="StartDate" class="form-label fw-semibold" style="color: #374151;">
                            <i class="bi bi-calendar-fill me-1" style="color: #22c55e;"></i>@L["StartDate"]
                        </label>
                        <input asp-for="StartDate" class="form-control" type="date" />
                        <span asp-validation-for="StartDate" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EndDate" class="form-label fw-semibold" style="color: #374151;">
                            <i class="bi bi-calendar-check-fill me-1" style="color: #ef4444;"></i>@L["EndDate"]
                        </label>
                        <input asp-for="EndDate" class="form-control" type="date" />
                        <span asp-validation-for="EndDate" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Department Change fields -->
                <div id="departmentChangeFields" style="display: none;">
                    <div class="mb-3">
                        <label asp-for="TargetDepartmentId" class="form-label fw-semibold" style="color: #374151;">
                            <i class="bi bi-building-fill me-1" style="color: #3b82f6;"></i>@L["TargetDepartment"]
                        </label>
                        <select asp-for="TargetDepartmentId" class="form-select" asp-items="Model.Departments">
                            <option value="">@L["SelectDepartment"]</option>
                        </select>
                        <span asp-validation-for="TargetDepartmentId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-custom-primary">
                        <i class="bi bi-send-fill me-1"></i>@L["SubmitRequest"]
                    </button>
                    <a asp-action="Index" class="btn btn-custom-secondary">
                        <i class="bi bi-x-lg me-1"></i>@L["Cancel"]
                    </a>
                </div>
            </form>
        </div>
    </div>
    <div class="col-md-6 mt-4 mt-md-0">
        <div class="card-custom">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-info-circle-fill me-2"></i>@L["Information"]</h5>
            </div>
            <div class="card-body">
                <p style="color: #1e293b;">
                    <strong>@L["Vacation"]:</strong> @L["VacationDescription"]
                </p>
                <p class="mb-0" style="color: #1e293b;">
                    <strong>@L["DepartmentChange"]:</strong> @L["DepartmentChangeDescription"]
                </p>
            </div>
            <div class="card-footer">
                <small style="color: #64748b;">
                    <i class="bi bi-clock me-1"></i>@L["RequestReviewNote"]
                </small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var requestType = document.getElementById('requestType');
            var vacationFields = document.getElementById('vacationFields');
            var departmentChangeFields = document.getElementById('departmentChangeFields');

            function toggleFields() {
                var selectedValue = requestType.value;
                
                if (selectedValue === '0') { // Vacation
                    vacationFields.style.display = 'block';
                    departmentChangeFields.style.display = 'none';
                } else if (selectedValue === '1') { // DepartmentChange
                    vacationFields.style.display = 'none';
                    departmentChangeFields.style.display = 'block';
                } else {
                    vacationFields.style.display = 'block';
                    departmentChangeFields.style.display = 'none';
                }
            }

            requestType.addEventListener('change', toggleFields);
            toggleFields(); // Initial state
        });
    </script>
}

@model WorkFlowManager.ViewModels.CreateRequestViewModel

@{
    ViewData["Title"] = "Submit Request";
}

<h2><i class="bi bi-plus-circle me-2"></i>Submit New Request</h2>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label asp-for="Type" class="form-label"></label>
                        <select asp-for="Type" class="form-select" id="requestType" asp-items="Html.GetEnumSelectList<WorkFlowManager.Models.RequestType>()">
                            <option value="">-- Select Type --</option>
                        </select>
                        <span asp-validation-for="Type" class="text-danger"></span>
                    </div>

                    <!-- Vacation fields (dates) -->
                    <div id="vacationFields">
                        <div class="mb-3">
                            <label asp-for="StartDate" class="form-label"></label>
                            <input asp-for="StartDate" class="form-control" type="date" />
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EndDate" class="form-label"></label>
                            <input asp-for="EndDate" class="form-control" type="date" />
                            <span asp-validation-for="EndDate" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Department Change fields -->
                    <div id="departmentChangeFields" style="display: none;">
                        <div class="mb-3">
                            <label asp-for="TargetDepartmentId" class="form-label"></label>
                            <select asp-for="TargetDepartmentId" class="form-select" asp-items="Model.Departments">
                                <option value="">-- Select Department --</option>
                            </select>
                            <span asp-validation-for="TargetDepartmentId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-send me-1"></i>Submit Request
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Back
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card bg-light">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-info-circle me-2"></i>Information</h5>
                <p class="card-text">
                    <strong>Vacation:</strong> Request time off for holidays or personal days. 
                    Select start and end dates for your leave.<br/><br/>
                    <strong>Department Change:</strong> Request transfer to a different department. 
                    Select the department you wish to join.
                </p>
                <hr />
                <p class="card-text text-muted small">
                    Your request will be reviewed by an administrator. You will be notified once a decision has been made.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var requestType = document.getElementById('requestType');
            var vacationFields = document.getElementById('vacationFields');
            var departmentChangeFields = document.getElementById('departmentChangeFields');

            function toggleFields() {
                var selectedValue = requestType.value;
                
                if (selectedValue === '0') { // Vacation
                    vacationFields.style.display = 'block';
                    departmentChangeFields.style.display = 'none';
                } else if (selectedValue === '1') { // DepartmentChange
                    vacationFields.style.display = 'none';
                    departmentChangeFields.style.display = 'block';
                } else {
                    vacationFields.style.display = 'block';
                    departmentChangeFields.style.display = 'none';
                }
            }

            requestType.addEventListener('change', toggleFields);
            toggleFields(); // Initial state
        });
    </script>
}

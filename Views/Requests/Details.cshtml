@model WorkFlowManager.Models.LeaveRequest

@{
    ViewData["Title"] = "Request Details";
}

<h2><i class="bi bi-file-text me-2"></i>Request Details</h2>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header">
                <strong>Request #@Model.Id</strong>
                @switch (Model.Status)
                {
                    case WorkFlowManager.Models.RequestStatus.Pending:
                        <span class="badge bg-warning text-dark float-end">Pending</span>
                        break;
                    case WorkFlowManager.Models.RequestStatus.Approved:
                        <span class="badge bg-success float-end">Approved</span>
                        break;
                    case WorkFlowManager.Models.RequestStatus.Rejected:
                        <span class="badge bg-danger float-end">Rejected</span>
                        break;
                }
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Request Type</dt>
                    <dd class="col-sm-8">
                        @if (Model.Type == WorkFlowManager.Models.RequestType.Vacation)
                        {
                            <i class="bi bi-umbrella-fill text-info me-1"></i>@("Vacation")
                        }
                        else
                        {
                            <i class="bi bi-building text-secondary me-1"></i>@("Department Change")
                        }
                    </dd>

                    <dt class="col-sm-4">Employee</dt>
                    <dd class="col-sm-8">@Model.User?.FirstName @Model.User?.LastName</dd>

                    <dt class="col-sm-4">Start Date</dt>
                    <dd class="col-sm-8">@Model.StartDate.ToString("dddd, dd MMMM yyyy")</dd>

                    <dt class="col-sm-4">End Date</dt>
                    <dd class="col-sm-8">@Model.EndDate.ToString("dddd, dd MMMM yyyy")</dd>

                    <dt class="col-sm-4">Duration</dt>
                    <dd class="col-sm-8">@((Model.EndDate - Model.StartDate).Days + 1) days</dd>

                    <dt class="col-sm-4">Submitted On</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")</dd>

                    @if (!string.IsNullOrEmpty(Model.AdminComment))
                    {
                        <dt class="col-sm-4">Admin Comment</dt>
                        <dd class="col-sm-8">
                            <div class="alert alert-secondary mb-0">
                                @Model.AdminComment
                            </div>
                        </dd>
                    }
                </dl>
            </div>
        </div>

        <div class="mt-3">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back to My Requests
            </a>
        </div>
    </div>
</div>


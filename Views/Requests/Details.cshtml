@model WorkFlowManager.Models.LeaveRequest

@{
    ViewData["Title"] = "Request Details";
}

<div class="page-header">
    <h1><i class="bi bi-file-text-fill"></i>Request Details</h1>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card-custom">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-hash me-1"></i>Request #@Model.Id</h5>
                @switch (Model.Status)
                {
                    case WorkFlowManager.Models.RequestStatus.Pending:
                        <span class="badge-custom-warning">Pending</span>
                        break;
                    case WorkFlowManager.Models.RequestStatus.Approved:
                        <span class="badge-custom-success">Approved</span>
                        break;
                    case WorkFlowManager.Models.RequestStatus.Rejected:
                        <span class="badge-custom-danger">Rejected</span>
                        break;
                }
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold" style="color: #64748b;">
                            <i class="bi bi-tag-fill me-1"></i>Request Type
                        </label>
                        <p class="mb-0">
                            @if (Model.Type == WorkFlowManager.Models.RequestType.Vacation)
                            {
                                <span class="badge-custom-info">
                                    <i class="bi bi-umbrella-fill me-1"></i>Vacation
                                </span>
                            }
                            else
                            {
                                <span class="badge-custom">
                                    <i class="bi bi-building me-1"></i>Department Change
                                </span>
                            }
                        </p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold" style="color: #64748b;">
                            <i class="bi bi-person-fill me-1"></i>Employee
                        </label>
                        <p class="mb-0" style="color: #1e293b;">@Model.User?.FirstName @Model.User?.LastName</p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold" style="color: #64748b;">
                            <i class="bi bi-calendar-fill me-1"></i>Start Date
                        </label>
                        <p class="mb-0" style="color: #1e293b;">@Model.StartDate.ToString("dddd, dd MMMM yyyy")</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold" style="color: #64748b;">
                            <i class="bi bi-calendar-check-fill me-1"></i>End Date
                        </label>
                        <p class="mb-0" style="color: #1e293b;">@Model.EndDate.ToString("dddd, dd MMMM yyyy")</p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold" style="color: #64748b;">
                            <i class="bi bi-hourglass-split me-1"></i>Duration
                        </label>
                        <p class="mb-0">
                            <span class="badge-custom-info">@((Model.EndDate - Model.StartDate).Days + 1) days</span>
                        </p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold" style="color: #64748b;">
                            <i class="bi bi-clock-fill me-1"></i>Submitted On
                        </label>
                        <p class="mb-0" style="color: #1e293b;">@Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")</p>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.AdminComment))
                {
                    <div class="mt-3">
                        <label class="form-label fw-semibold" style="color: #64748b;">
                            <i class="bi bi-chat-left-text-fill me-1"></i>Admin Comment
                        </label>
                        <div class="alert-custom-info mb-0">
                            @Model.AdminComment
                        </div>
                    </div>
                }
            </div>
            <div class="card-footer">
                <a asp-action="Index" class="btn btn-custom-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Back to My Requests
                </a>
            </div>
        </div>
    </div>
</div>

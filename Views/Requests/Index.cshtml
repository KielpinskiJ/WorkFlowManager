@model IEnumerable<WorkFlowManager.Models.LeaveRequest>

@{
    ViewData["Title"] = "My Requests";
}

<div class="page-header">
    <h1><i class="bi bi-inbox-fill"></i>My Requests</h1>
    <a asp-action="Create" class="btn btn-custom-primary">
        <i class="bi bi-plus-lg me-1"></i><span class="d-none d-sm-inline">New </span>Request
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert-custom-success mb-4">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
    </div>
}

@if (!Model.Any())
{
    <div class="alert-custom-info">
        <i class="bi bi-info-circle-fill me-2"></i>You haven't submitted any requests yet.
    </div>
}
else
{
    <div class="table-responsive">
        <div class="table-wrapper">
            <table class="table table-custom mb-0">
                <thead>
                    <tr>
                        <th><i class="bi bi-tag-fill me-1"></i>Type</th>
                        <th class="d-none d-md-table-cell"><i class="bi bi-calendar-fill me-1"></i>Start</th>
                        <th class="d-none d-md-table-cell"><i class="bi bi-calendar-check-fill me-1"></i>End</th>
                        <th><i class="bi bi-flag-fill me-1"></i>Status</th>
                        <th class="d-none d-lg-table-cell"><i class="bi bi-clock-fill me-1"></i>Submitted</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model)
                    {
                        <tr>
                            <td>
                                @if (request.Type == WorkFlowManager.Models.RequestType.Vacation)
                                {
                                    <span class="badge-custom-info">
                                        <i class="bi bi-umbrella-fill me-1"></i>Vacation
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-custom">
                                        <i class="bi bi-building me-1"></i>Dept. Change
                                    </span>
                                }
                            </td>
                            <td class="d-none d-md-table-cell" style="color: #475569;">@request.StartDate.ToString("dd MMM yyyy")</td>
                            <td class="d-none d-md-table-cell" style="color: #475569;">@request.EndDate.ToString("dd MMM yyyy")</td>
                            <td>
                                @switch (request.Status)
                                {
                                    case WorkFlowManager.Models.RequestStatus.Pending:
                                        <span class="badge-custom-warning">
                                            <i class="bi bi-hourglass-split me-1"></i>Pending
                                        </span>
                                        break;
                                    case WorkFlowManager.Models.RequestStatus.Approved:
                                        <span class="badge-custom-success">
                                            <i class="bi bi-check-lg me-1"></i>Approved
                                        </span>
                                        break;
                                    case WorkFlowManager.Models.RequestStatus.Rejected:
                                        <span class="badge-custom-danger">
                                            <i class="bi bi-x-lg me-1"></i>Rejected
                                        </span>
                                        break;
                                }
                            </td>
                            <td class="d-none d-lg-table-cell" style="color: #64748b;">@request.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td class="text-end" style="white-space: nowrap;">
                                <a asp-action="Details" asp-route-id="@request.Id" class="btn btn-custom-info btn-custom-sm" title="Details">
                                    <i class="bi bi-eye-fill"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@model IEnumerable<WorkFlowManager.Models.LeaveRequest>

@{
    ViewData["Title"] = "My Requests";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-inbox me-2"></i>My Requests</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>New Request
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>You haven't submitted any requests yet.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Type</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Status</th>
                    <th>Submitted</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model)
                {
                    <tr>
                        <td>
                            @if (request.Type == WorkFlowManager.Models.RequestType.Vacation)
                            {
                                <span class="badge bg-info">
                                    <i class="bi bi-umbrella-fill me-1"></i>Vacation
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    <i class="bi bi-building me-1"></i>Department Change
                                </span>
                            }
                        </td>
                        <td>@request.StartDate.ToString("dd MMM yyyy")</td>
                        <td>@request.EndDate.ToString("dd MMM yyyy")</td>
                        <td>
                            @switch (request.Status)
                            {
                                case WorkFlowManager.Models.RequestStatus.Pending:
                                    <span class="badge bg-warning text-dark">
                                        <i class="bi bi-hourglass-split me-1"></i>Pending
                                    </span>
                                    break;
                                case WorkFlowManager.Models.RequestStatus.Approved:
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-lg me-1"></i>Approved
                                    </span>
                                    break;
                                case WorkFlowManager.Models.RequestStatus.Rejected:
                                    <span class="badge bg-danger">
                                        <i class="bi bi-x-lg me-1"></i>Rejected
                                    </span>
                                    break;
                            }
                        </td>
                        <td>@request.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@request.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}


@model IEnumerable<WorkFlowManager.Models.LeaveRequest>

@{
    ViewData["Title"] = "My Requests";
    var selectedMonths = (int?)ViewBag.SelectedMonths;
    var hidePending = (bool)(ViewBag.HidePending ?? false);
    var hideApproved = (bool)(ViewBag.HideApproved ?? false);
    var hideRejected = (bool)(ViewBag.HideRejected ?? false);
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    
    var periodLabel = selectedMonths switch
    {
        1 => "Last month",
        3 => "Last 3 months",
        6 => "Last 6 months",
        12 => "Last 12 months",
        _ => "All time"
    };
}

<div class="page-header">
    <h1><i class="bi bi-inbox-fill"></i>My Requests</h1>
    <a asp-action="Create" class="btn btn-custom-primary">
        <i class="bi bi-plus-lg me-1"></i><span class="d-none d-sm-inline">New </span>Request
    </a>
</div>

<div class="card-custom mb-4">
    <div class="card-body py-3">
        <form method="get" class="row g-3 align-items-center">
            <!-- Time Period Filter -->
            <div class="col-md-3">
                <label class="form-label fw-semibold mb-1" style="color: #374151;">
                    <i class="bi bi-calendar-range me-1" style="color: #3b82f6;"></i>Time Period
                </label>
                <select name="months" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="" selected="@(selectedMonths == null)">All time</option>
                    <option value="1" selected="@(selectedMonths == 1)">Last month</option>
                    <option value="3" selected="@(selectedMonths == 3)">Last 3 months</option>
                    <option value="6" selected="@(selectedMonths == 6)">Last 6 months</option>
                    <option value="12" selected="@(selectedMonths == 12)">Last 12 months</option>
                </select>
            </div>
            
            <div class="col-md-6">
                <label class="form-label fw-semibold mb-1" style="color: #374151;">
                    <i class="bi bi-funnel me-1" style="color: #3b82f6;"></i>Hide Status
                </label>
                <div class="d-flex gap-3 flex-wrap">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="hidePending" value="true" 
                               id="hidePending" checked="@hidePending" onchange="this.form.submit()">
                        <label class="form-check-label" for="hidePending" style="color: #f59e0b;">
                            <i class="bi bi-hourglass-split me-1"></i>Pending
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="hideApproved" value="true" 
                               id="hideApproved" checked="@hideApproved" onchange="this.form.submit()">
                        <label class="form-check-label" for="hideApproved" style="color: #22c55e;">
                            <i class="bi bi-check-lg me-1"></i>Approved
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="hideRejected" value="true" 
                               id="hideRejected" checked="@hideRejected" onchange="this.form.submit()">
                        <label class="form-check-label" for="hideRejected" style="color: #ef4444;">
                            <i class="bi bi-x-lg me-1"></i>Rejected
                        </label>
                    </div>
                </div>
            </div>
            
            <div class="col-md-3 text-md-end">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Reset Filters
                </a>
                <noscript>
                    <button type="submit" class="btn btn-custom-primary btn-sm">
                        <i class="bi bi-funnel me-1"></i>Apply
                    </button>
                </noscript>
            </div>
        </form>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert-custom-success mb-4">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
    </div>
}

@if (!Model.Any())
{
    <div class="alert-custom-info">
        <i class="bi bi-info-circle-fill me-2"></i>
        @if (selectedMonths.HasValue || hidePending || hideApproved || hideRejected)
        {
            <span>No requests match your current filters. <a asp-action="Index">Clear filters</a> to see all requests.</span>
        }
        else
        {
            <span>You haven't submitted any requests yet.</span>
        }
    </div>
}
else
{
    <div class="table-responsive">
        <div class="table-wrapper">
            <table class="table table-custom mb-0">
                <thead>
                    <tr>
                        <th><i class="bi bi-tag-fill me-1"></i>Type</th>
                        <th class="d-none d-md-table-cell"><i class="bi bi-calendar-fill me-1"></i>Start</th>
                        <th class="d-none d-md-table-cell"><i class="bi bi-calendar-check-fill me-1"></i>End</th>
                        <th><i class="bi bi-flag-fill me-1"></i>Status</th>
                        <th class="d-none d-lg-table-cell"><i class="bi bi-clock-fill me-1"></i>Submitted</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model)
                    {
                        <tr>
                            <td>
                                @if (request.Type == WorkFlowManager.Models.RequestType.Vacation)
                                {
                                    <span class="badge-custom-info">
                                        <i class="bi bi-umbrella-fill me-1"></i>Vacation
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-custom">
                                        <i class="bi bi-building me-1"></i>Dept. Change
                                    </span>
                                }
                            </td>
                            <td class="d-none d-md-table-cell" style="color: #475569;">@request.StartDate.ToString("dd MMM yyyy")</td>
                            <td class="d-none d-md-table-cell" style="color: #475569;">@request.EndDate.ToString("dd MMM yyyy")</td>
                            <td>
                                @switch (request.Status)
                                {
                                    case WorkFlowManager.Models.RequestStatus.Pending:
                                        <span class="badge-custom-warning">
                                            <i class="bi bi-hourglass-split me-1"></i>Pending
                                        </span>
                                        break;
                                    case WorkFlowManager.Models.RequestStatus.Approved:
                                        <span class="badge-custom-success">
                                            <i class="bi bi-check-lg me-1"></i>Approved
                                        </span>
                                        break;
                                    case WorkFlowManager.Models.RequestStatus.Rejected:
                                        <span class="badge-custom-danger">
                                            <i class="bi bi-x-lg me-1"></i>Rejected
                                        </span>
                                        break;
                                }
                            </td>
                            <td class="d-none d-lg-table-cell" style="color: #64748b;">@request.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td class="text-end" style="white-space: nowrap;">
                                <a asp-action="Details" asp-route-id="@request.Id" class="btn btn-custom-info btn-custom-sm" title="Details">
                                    <i class="bi bi-eye-fill"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (totalPages > 1)
    {
        <nav aria-label="Page navigation" class="mt-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span class="text-muted small">
                    Showing @((currentPage - 1) * 20 + 1)-@(Math.Min(currentPage * 20, totalCount)) of @totalCount requests
                </span>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@(currentPage - 1)"
                           asp-route-months="@selectedMonths"
                           asp-route-hidePending="@(hidePending ? "true" : null)"
                           asp-route-hideApproved="@(hideApproved ? "true" : null)"
                           asp-route-hideRejected="@(hideRejected ? "true" : null)">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-page="@i"
                               asp-route-months="@selectedMonths"
                               asp-route-hidePending="@(hidePending ? "true" : null)"
                               asp-route-hideApproved="@(hideApproved ? "true" : null)"
                               asp-route-hideRejected="@(hideRejected ? "true" : null)">@i</a>
                        </li>
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@(currentPage + 1)"
                           asp-route-months="@selectedMonths"
                           asp-route-hidePending="@(hidePending ? "true" : null)"
                           asp-route-hideApproved="@(hideApproved ? "true" : null)"
                           asp-route-hideRejected="@(hideRejected ? "true" : null)">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </div>
        </nav>
    }
}

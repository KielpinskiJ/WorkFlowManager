@model IEnumerable<WorkFlowManager.Models.LeaveRequest>

@{
    ViewData["Title"] = "Manage Requests";
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var selectedType = (string?)ViewBag.SelectedType;
}

<div class="page-header">
    <h1><i class="bi bi-clipboard-check-fill"></i>Manage Requests</h1>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert-custom-success mb-4">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert-custom-danger mb-4">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
    </div>
}

<div class="card-custom mb-4">
    <div class="card-body py-3">
        <div class="row g-3 align-items-center">
            <div class="col-md-6">
                <label class="form-label fw-semibold mb-2" style="color: #374151;">
                    <i class="bi bi-funnel me-1" style="color: #3b82f6;"></i>Filter by Type
                </label>
                <div class="d-flex gap-2 flex-wrap">
                    <a asp-action="Manage" 
                       class="btn @(string.IsNullOrEmpty(selectedType) ? "btn-primary" : "btn-outline-primary") btn-sm">
                        <i class="bi bi-collection me-1"></i>All Types
                        @if (string.IsNullOrEmpty(selectedType))
                        {
                            <span class="badge bg-white text-primary ms-1">@totalCount</span>
                        }
                    </a>
                    <a asp-action="Manage" asp-route-requestType="Vacation" 
                       class="btn @(selectedType == "Vacation" ? "btn-info" : "btn-outline-info") btn-sm">
                        <i class="bi bi-umbrella-fill me-1"></i>Vacation
                        @if (selectedType == "Vacation")
                        {
                            <span class="badge bg-white text-info ms-1">@totalCount</span>
                        }
                    </a>
                    <a asp-action="Manage" asp-route-requestType="DepartmentChange" 
                       class="btn @(selectedType == "DepartmentChange" ? "btn-secondary" : "btn-outline-secondary") btn-sm">
                        <i class="bi bi-building me-1"></i>Dept. Change
                        @if (selectedType == "DepartmentChange")
                        {
                            <span class="badge bg-white text-secondary ms-1">@totalCount</span>
                        }
                    </a>
                </div>
            </div>
            <div class="col-md-6 text-md-end">
                <span class="text-muted">
                    <i class="bi bi-hourglass-split me-1"></i>
                    <strong>@totalCount</strong> pending request@(totalCount != 1 ? "s" : "")
                    @if (!string.IsNullOrEmpty(selectedType))
                    {
                        <span class="ms-1">(filtered)</span>
                    }
                </span>
            </div>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert-custom-info">
        <i class="bi bi-inbox-fill me-2"></i>
        @if (!string.IsNullOrEmpty(selectedType))
        {
            <span>No pending <strong>@(selectedType == "Vacation" ? "vacation" : "department change")</strong> requests. 
            <a asp-action="Manage">View all types</a>.</span>
        }
        else
        {
            <span>No pending requests to review.</span>
        }
    </div>
}
else
{
    <div class="table-responsive">
        <div class="table-wrapper">
            <table class="table table-custom mb-0">
                <thead>
                    <tr>
                        <th><i class="bi bi-person-fill me-1"></i>Employee</th>
                        <th><i class="bi bi-tag-fill me-1"></i>Type</th>
                        <th class="d-none d-md-table-cell"><i class="bi bi-info-circle-fill me-1"></i>Details</th>
                        <th class="d-none d-lg-table-cell"><i class="bi bi-clock-fill me-1"></i>Submitted</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model)
                    {
                        <tr>
                            <td>
                                <strong style="color: #1e293b;">@request.User?.FirstName @request.User?.LastName</strong>
                                <span class="d-block small" style="color: #64748b;">@request.User?.Email</span>
                            </td>
                            <td>
                                @if (request.Type == WorkFlowManager.Models.RequestType.Vacation)
                                {
                                    <span class="badge-custom-info">
                                        <i class="bi bi-umbrella-fill me-1"></i>Vacation
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-custom">
                                        <i class="bi bi-building me-1"></i>Dept. Change
                                    </span>
                                }
                            </td>
                            <td class="d-none d-md-table-cell">
                                @if (request.Type == WorkFlowManager.Models.RequestType.Vacation)
                                {
                                    <small style="color: #475569;">
                                        @request.StartDate.ToString("dd MMM") - @request.EndDate.ToString("dd MMM yyyy")
                                        <span class="d-block" style="color: #94a3b8;">(@((request.EndDate - request.StartDate).Days + 1) days)</span>
                                    </small>
                                }
                                else
                                {
                                    <small style="color: #475569;">
                                        Target: <strong>@(request.TargetDepartment?.Name ?? "Not specified")</strong>
                                    </small>
                                }
                            </td>
                            <td class="d-none d-lg-table-cell" style="color: #64748b;">@request.CreatedAt.ToString("dd MMM")</td>
                            <td class="text-end" style="white-space: nowrap;">
                                <div class="btn-group-vertical" role="group">
                                    <button type="button" class="btn btn-custom-success btn-custom-sm mb-1" 
                                            data-bs-toggle="modal" 
                                            data-bs-target="#approveModal-@request.Id" 
                                            title="Approve">
                                        <i class="bi bi-check-lg"></i> Approve
                                    </button>
                                    
                                    <button type="button" class="btn btn-custom-danger btn-custom-sm" 
                                            data-bs-toggle="modal" 
                                            data-bs-target="#rejectModal-@request.Id" 
                                            title="Reject">
                                        <i class="bi bi-x-lg"></i> Reject
                                    </button>
                                </div>

                                @if (request.Type == WorkFlowManager.Models.RequestType.Vacation)
                                {
                                    <!-- Approve Modal for Vacation -->
                                    <div class="modal fade" id="approveModal-@request.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <div class="modal-header" style="background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%); color: white;">
                                                    <h5 class="modal-title"><i class="bi bi-check-circle-fill me-2"></i>Approve Vacation Request</h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <form asp-action="Approve" asp-route-id="@request.Id" method="post">
                                                    <div class="modal-body">
                                                        <p style="color: #1e293b;">
                                                            Approve vacation request for <strong>@request.User?.FirstName @request.User?.LastName</strong>?
                                                        </p>
                                                        <p style="color: #475569;">
                                                            <i class="bi bi-calendar-range me-1"></i>
                                                            @request.StartDate.ToString("dd MMM") - @request.EndDate.ToString("dd MMM yyyy")
                                                            <span class="text-muted">(@((request.EndDate - request.StartDate).Days + 1) days)</span>
                                                        </p>
                                                        
                                                        <div class="mb-3">
                                                            <label class="form-label" style="color: #374151;">Comment (optional)</label>
                                                            <textarea name="adminComment" class="form-control" rows="2" placeholder="Add a note..." maxlength="500"></textarea>
                                                            <div class="form-text">Maximum 500 characters</div>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-custom-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-custom-success">
                                                            <i class="bi bi-check-lg me-1"></i>Approve Request
                                                        </button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else if (request.Type == WorkFlowManager.Models.RequestType.DepartmentChange && request.TargetDepartmentId.HasValue)
                                {
                                    <!-- Approve Modal for Department Change -->
                                    <div class="modal fade" id="approveModal-@request.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <div class="modal-header" style="background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%); color: white;">
                                                    <h5 class="modal-title"><i class="bi bi-check-circle-fill me-2"></i>Approve Department Change</h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <form asp-action="Approve" asp-route-id="@request.Id" method="post">
                                                    <div class="modal-body">
                                                        <p style="color: #1e293b;">
                                                            <strong>@request.User?.FirstName @request.User?.LastName</strong> 
                                                            wants to transfer to <strong>@request.TargetDepartment?.Name</strong>.
                                                        </p>
                                                        
                                                        <div class="form-check mb-3">
                                                            <input class="form-check-input" type="checkbox" name="autoTransfer" value="true" id="autoTransfer-@request.Id" checked>
                                                            <label class="form-check-label" for="autoTransfer-@request.Id" style="color: #374151;">
                                                                <strong>Automatically transfer employee to @request.TargetDepartment?.Name</strong>
                                                            </label>
                                                            <div class="form-text">
                                                                If unchecked, you will need to manually change the employee's department.
                                                            </div>
                                                        </div>
                                                        
                                                        <div class="mb-3">
                                                            <label class="form-label" style="color: #374151;">Comment (optional)</label>
                                                            <textarea name="adminComment" class="form-control" rows="2" placeholder="Add a note..." maxlength="500"></textarea>
                                                            <div class="form-text">Maximum 500 characters</div>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-custom-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-custom-success">
                                                            <i class="bi bi-check-lg me-1"></i>Approve Request
                                                        </button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <!-- Reject Modal -->
                                <div class="modal fade" id="rejectModal-@request.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white;">
                                                <h5 class="modal-title"><i class="bi bi-x-circle-fill me-2"></i>Reject Request</h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <form asp-action="Reject" asp-route-id="@request.Id" method="post">
                                                <div class="modal-body">
                                                    <p style="color: #1e293b;">Are you sure you want to reject this request from <strong>@request.User?.FirstName @request.User?.LastName</strong>?</p>
                                                    <div class="mb-3">
                                                        <label class="form-label" style="color: #374151;">Comment (optional)</label>
                                                        <textarea name="adminComment" class="form-control" rows="3" placeholder="Reason for rejection..." maxlength="500"></textarea>
                                                        <div class="form-text">Maximum 500 characters</div>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-custom-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-custom-danger">
                                                        <i class="bi bi-x-lg me-1"></i>Reject Request
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    @if (totalPages > 1)
    {
        <nav aria-label="Requests pagination" class="my-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span class="text-muted small">
                    Showing @((currentPage - 1) * 20 + 1)-@(Math.Min(currentPage * 20, totalCount)) of @totalCount requests
                </span>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Manage" 
                           asp-route-page="@(currentPage - 1)"
                           asp-route-requestType="@selectedType">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    @{
                        var startPage = Math.Max(1, currentPage - 2);
                        var endPage = Math.Min(totalPages, currentPage + 2);
                        
                        if (startPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Manage" asp-route-page="1" 
                                   asp-route-requestType="@selectedType">1</a>
                            </li>
                            if (startPage > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }
                    }
                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="Manage" asp-route-page="@i" 
                               asp-route-requestType="@selectedType">@i</a>
                        </li>
                    }
                    @if (endPage < totalPages)
                    {
                        if (endPage < totalPages - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                        <li class="page-item">
                            <a class="page-link" asp-action="Manage" asp-route-page="@totalPages" 
                               asp-route-requestType="@selectedType">@totalPages</a>
                        </li>
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Manage" 
                           asp-route-page="@(currentPage + 1)"
                           asp-route-requestType="@selectedType">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </div>
        </nav>
    }
}

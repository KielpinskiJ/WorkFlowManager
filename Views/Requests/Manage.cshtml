@model IEnumerable<WorkFlowManager.Models.LeaveRequest>

@{
    ViewData["Title"] = "Manage Requests";
}

<h2><i class="bi bi-clipboard-check me-2"></i>Manage Pending Requests</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-inbox me-2"></i>No pending requests to review.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Employee</th>
                    <th>Type</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Days</th>
                    <th>Submitted</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model)
                {
                    <tr>
                        <td>
                            <strong>@request.User?.FirstName @request.User?.LastName</strong>
                            <br /><small class="text-muted">@request.User?.Email</small>
                        </td>
                        <td>
                            @if (request.Type == WorkFlowManager.Models.RequestType.Vacation)
                            {
                                <span class="badge bg-info">Vacation</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Dept. Change</span>
                            }
                        </td>
                        <td>@request.StartDate.ToString("dd MMM yyyy")</td>
                        <td>@request.EndDate.ToString("dd MMM yyyy")</td>
                        <td>@((request.EndDate - request.StartDate).Days + 1)</td>
                        <td>@request.CreatedAt.ToString("dd MMM")</td>
                        <td>
                            <div class="btn-group" role="group">
                                <!-- Approve Button -->
                                <form asp-action="Approve" asp-route-id="@request.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-success" title="Approve">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                </form>
                                
                                <!-- Reject Button with Modal -->
                                <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal-@request.Id" title="Reject">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                                
                                <!-- Details Button -->
                                <a asp-action="Details" asp-route-id="@request.Id" class="btn btn-sm btn-outline-primary" title="Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </div>

                            <!-- Reject Modal -->
                            <div class="modal fade" id="rejectModal-@request.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title">Reject Request</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <form asp-action="Reject" asp-route-id="@request.Id" method="post">
                                            <div class="modal-body">
                                                <p>Are you sure you want to reject this request from <strong>@request.User?.FirstName @request.User?.LastName</strong>?</p>
                                                <div class="mb-3">
                                                    <label class="form-label">Comment (optional)</label>
                                                    <textarea name="adminComment" class="form-control" rows="3" placeholder="Reason for rejection..."></textarea>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-danger">Reject Request</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}


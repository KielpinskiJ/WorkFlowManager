@inject IHtmlLocalizer<SharedResource> L
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WorkFlowManager</title>
    <!-- Bootswatch Zephyr Theme (Bootstrap 5) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/zephyr/bootstrap.min.css" crossorigin="anonymous" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" integrity="sha384-XGjxtQfXaH2tnPFa9x+ruJTuLE3Aa6LhHSWRr1XeTyhezb4abCG4ccI5AkVDxqC+" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WorkFlowManager.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom">
            <div class="container">
                <a class="navbar-brand navbar-brand-custom" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-kanban-fill me-2"></i>WorkFlowManager
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" 
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-fill me-1 icon-home"></i>@L["Home"]
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Departments" asp-action="Index">
                                <i class="bi bi-building-fill me-1 icon-dept"></i>@L["Departments"]
                            </a>
                        </li>
                        
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- Employee Menu -->
                            <li class="nav-item dropdown">
                                <a class="nav-link nav-link-custom dropdown-toggle dropdown-toggle-custom" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-badge-fill me-1"></i>@L["MyPanel"]
                                </a>
                                <ul class="dropdown-menu dropdown-menu-custom">
                                    <li>
                                        <a class="dropdown-item dropdown-item-custom" asp-area="" asp-controller="Shifts" asp-action="MySchedule">
                                            <i class="bi bi-calendar-check-fill me-2 icon-schedule"></i>@L["MySchedule"]
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item dropdown-item-custom" asp-area="" asp-controller="Requests" asp-action="Index">
                                            <i class="bi bi-inbox-fill me-2 icon-requests"></i>@L["MyRequests"]
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item dropdown-item-custom" asp-area="" asp-controller="Payroll" asp-action="MyPayroll">
                                            <i class="bi bi-wallet2 me-2 icon-payroll"></i>@L["MyPayroll"]
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        
                        @if (User.IsInRole("Admin"))
                        {
                            <!-- Admin Management Menu -->
                            <li class="nav-item dropdown">
                                <a class="nav-link nav-link-custom dropdown-toggle dropdown-toggle-custom" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-gear-wide-connected me-1"></i>@L["Management"]
                                </a>
                                <ul class="dropdown-menu dropdown-menu-custom">
                                    <li class="dropdown-header dropdown-header-custom">@L["ScheduleSection"]</li>
                                    <li>
                                        <a class="dropdown-item dropdown-item-custom" asp-area="" asp-controller="Shifts" asp-action="Index">
                                            <i class="bi bi-calendar-week-fill me-2 icon-schedule"></i>@L["AllShifts"]
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item dropdown-item-custom" asp-area="" asp-controller="Requests" asp-action="Manage">
                                            <i class="bi bi-clipboard-check-fill me-2 icon-requests"></i>@L["ManageRequests"]
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider dropdown-divider-custom"></li>
                                    <li class="dropdown-header dropdown-header-custom">@L["FinanceSection"]</li>
                                    <li>
                                        <a class="dropdown-item dropdown-item-custom" asp-area="" asp-controller="Bonuses" asp-action="Index">
                                            <i class="bi bi-gift-fill me-2 icon-bonuses"></i>@L["Bonuses"]
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item dropdown-item-custom" asp-area="" asp-controller="Payroll" asp-action="Index">
                                            <i class="bi bi-cash-stack me-2 icon-payroll"></i>@L["PayrollReport"]
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider dropdown-divider-custom"></li>
                                    <li class="dropdown-header dropdown-header-custom">@L["ReportsSection"]</li>
                                    <li>
                                        <a class="dropdown-item dropdown-item-custom" asp-area="" asp-controller="Stats" asp-action="Index">
                                            <i class="bi bi-bar-chart-line-fill me-2 icon-stats"></i>@L["Statistics"]
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item dropdown-item-custom" asp-area="" asp-controller="Users" asp-action="Index">
                                            <i class="bi bi-people-fill me-2 icon-users"></i>@L["Users"]
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>
                    
                    <!-- Language Switcher (moved next to profile) -->
                    <ul class="navbar-nav me-2">
                        <li class="nav-item dropdown">
                            <a class="nav-link nav-link-custom dropdown-toggle dropdown-toggle-custom" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-globe me-1"></i>@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToUpper()
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-custom">
                                <li>
                                    <a class="dropdown-item dropdown-item-custom @(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "active" : "")" href="/SetLanguage/en">
                                        🇬🇧 English
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item dropdown-item-custom @(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "pl" ? "active" : "")" href="/SetLanguage/pl">
                                        🇵🇱 Polski
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    
    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-custom py-3 mt-4">
        <div class="container">
            <div class="row align-items-center gy-2">
                <!-- Brand -->
                <div class="col-md-4 text-center text-md-start">
                    <a class="footer-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-kanban-fill me-1"></i>WorkFlowManager
                    </a>
                </div>
                
                <!-- Quick Links -->
                <div class="col-md-4 text-center">
                    <ul class="footer-nav">
                        <li><a class="footer-nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-house-fill me-1"></i>@L["Home"]</a></li>
                        <li><a class="footer-nav-link" asp-controller="Departments" asp-action="Index"><i class="bi bi-building-fill me-1"></i>@L["Departments"]</a></li>
                        <li><a class="footer-nav-link" asp-controller="Home" asp-action="Privacy"><i class="bi bi-shield-check me-1"></i>@L["PrivacyPolicy"]</a></li>
                    </ul>
                </div>
                
                <!-- Social -->
                <div class="col-md-4 text-center text-md-end">
                    <div class="footer-social justify-content-center justify-content-md-end">
                        <a href="https://github.com/KielpinskiJ/WorkFlowManager" target="_blank" class="footer-social-link" title="GitHub"><i class="bi bi-github"></i></a>
                        <a href="https://www.linkedin.com/school/uniwersytet-merito-poznan" target="_blank" class="footer-social-link" title="LinkedIn"><i class="bi bi-linkedin"></i></a>
                        <a href="https://www.poczta-polska.pl/" target="_blank" class="footer-social-link" title="Email"><i class="bi bi-envelope-fill"></i></a>
                    </div>
                </div>
            </div>
            
            <div class="text-center footer-copyright mt-2">
                &copy; 2026 WorkFlowManager &bull; Made with <span class="fish">🐟</span> by Team JDK
            </div>
        </div>
    </footer>
    
    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@using Microsoft.AspNetCore.Identity
@using WorkFlowManager.Models
@using Microsoft.AspNetCore.Mvc.Localization

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IHtmlLocalizer<SharedResource> L

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a class="nav-link login-link-custom" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
            <span class="user-badge-custom">
                <i class="bi bi-person-circle me-1"></i>@User.Identity?.Name
            </span>
        </a>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="nav-link login-link-custom btn btn-link border-0 px-2">
                <i class="bi bi-box-arrow-right me-1"></i>@L["Logout"]
            </button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link login-link-custom" asp-area="Identity" asp-page="/Account/Register">
            <i class="bi bi-person-plus me-1"></i>@L["Register"]
        </a>
    </li>
    <li class="nav-item ms-2">
        <a class="btn login-btn-custom" asp-area="Identity" asp-page="/Account/Login">
            <i class="bi bi-box-arrow-in-right me-1"></i>@L["Login"]
        </a>
    </li>
}
</ul>

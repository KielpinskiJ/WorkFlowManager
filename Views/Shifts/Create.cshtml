@model WorkFlowManager.ViewModels.CreateShiftViewModel
@inject IHtmlLocalizer<SharedResource> L

@{
    ViewData["Title"] = L["CreateShift"].Value;
}

<div class="page-header">
    <h1><i class="bi bi-calendar-plus-fill"></i>@L["CreateShift"]</h1>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="form-custom">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                
                <div asp-validation-summary="ModelOnly" class="alert-custom-danger mb-3" role="alert"></div>
                
                <div class="mb-3">
                    <label asp-for="UserId" class="form-label fw-semibold" style="color: #374151;">
                        <i class="bi bi-person-fill me-1" style="color: #3b82f6;"></i>@L["Employee"]
                    </label>
                    <select asp-for="UserId" asp-items="Model.Users" class="form-select">
                        <option value="">@L["SelectEmployee"]</option>
                    </select>
                    <span asp-validation-for="UserId" class="text-danger small"></span>
                </div>
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="StartTime" class="form-label fw-semibold" style="color: #374151;">
                            <i class="bi bi-clock me-1" style="color: #22c55e;"></i>@L["StartTime"]
                        </label>
                        <input asp-for="StartTime" type="datetime-local" class="form-control" />
                        <span asp-validation-for="StartTime" class="text-danger small"></span>
                    </div>
                    
                    <div class="col-md-6 mb-3">
                        <label asp-for="EndTime" class="form-label fw-semibold" style="color: #374151;">
                            <i class="bi bi-clock-fill me-1" style="color: #ef4444;"></i>@L["EndTime"]
                        </label>
                        <input asp-for="EndTime" type="datetime-local" class="form-control" />
                        <span asp-validation-for="EndTime" class="text-danger small"></span>
                    </div>
                </div>
                
                <div class="alert-custom-info mb-4">
                    <i class="bi bi-lightbulb-fill me-2"></i>
                    <strong>@L["Tip"]</strong> @L["TipEndTimeAfterStart"]
                </div>
                
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-custom-primary">
                        <i class="bi bi-check-lg me-1"></i>@L["CreateShift"]
                    </button>
                    <a asp-action="Index" class="btn btn-custom-secondary">
                        <i class="bi bi-x-lg me-1"></i>@L["Cancel"]
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model WorkFlowManager.Models.WorkShift

@{
    ViewData["Title"] = "Shift Details";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-secondary text-white">
                <h4 class="mb-0"><i class="bi bi-calendar-event me-2"></i>Shift Details</h4>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Employee</dt>
                    <dd class="col-sm-8">
                        @if (Model.User != null)
                        {
                            <strong>@Model.User.FirstName @Model.User.LastName</strong>
                            <br />
                            <small class="text-muted">@Model.User.Email</small>
                        }
                        else
                        {
                            <span class="text-muted">Unknown</span>
                        }
                    </dd>
                    
                    <dt class="col-sm-4">Date</dt>
                    <dd class="col-sm-8">
                        @Model.StartTime.ToString("dddd, dd MMMM yyyy")
                    </dd>
                    
                    <dt class="col-sm-4">Start Time</dt>
                    <dd class="col-sm-8">
                        <i class="bi bi-clock text-success me-1"></i>
                        @Model.StartTime.ToString("HH:mm")
                    </dd>
                    
                    <dt class="col-sm-4">End Time</dt>
                    <dd class="col-sm-8">
                        <i class="bi bi-clock-fill text-danger me-1"></i>
                        @Model.EndTime.ToString("HH:mm")
                    </dd>
                    
                    <dt class="col-sm-4">Duration</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-info fs-6">@Model.DurationHours.ToString("F1") hours</span>
                    </dd>
                </dl>
                
                <hr />
                
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Back to List
                    </a>
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Are you sure you want to delete this shift?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i>Delete
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


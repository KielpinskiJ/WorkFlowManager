@model IEnumerable<WorkFlowManager.Models.WorkShift>

@{
    ViewData["Title"] = "Work Shifts";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-calendar-week me-2"></i>Work Shifts</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Add Shift
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-1"></i>No shifts scheduled yet. Click "Add Shift" to create one.
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-primary">
                    <tr>
                        <th>Employee</th>
                        <th>Date</th>
                        <th>Start Time</th>
                        <th>End Time</th>
                        <th>Duration</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var shift in Model)
                    {
                        <tr>
                            <td>
                                @if (shift.User != null)
                                {
                                    <span class="fw-medium">@shift.User.FirstName @shift.User.LastName</span>
                                    <br />
                                    <small class="text-muted">@shift.User.Email</small>
                                }
                                else
                                {
                                    <span class="text-muted">Unknown User</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark">
                                    @shift.StartTime.ToString("dddd")
                                </span>
                                <br />
                                @shift.StartTime.ToString("dd MMM yyyy")
                            </td>
                            <td>
                                <i class="bi bi-clock text-success me-1"></i>
                                @shift.StartTime.ToString("HH:mm")
                            </td>
                            <td>
                                <i class="bi bi-clock-fill text-danger me-1"></i>
                                @shift.EndTime.ToString("HH:mm")
                            </td>
                            <td>
                                <span class="badge bg-info">
                                    @shift.DurationHours.ToString("F1") hrs
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@shift.Id" class="btn btn-sm btn-outline-secondary" title="Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@shift.Id" method="post" class="d-inline" 
                                      onsubmit="return confirm('Are you sure you want to delete this shift?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    <div class="mt-3 text-muted">
        <small><i class="bi bi-info-circle me-1"></i>Total shifts: @Model.Count()</small>
    </div>
}


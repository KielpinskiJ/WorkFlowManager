@model IEnumerable<WorkFlowManager.Models.WorkShift>

@{
    ViewData["Title"] = "Work Shifts";
}

<div class="page-header">
    <h1><i class="bi bi-calendar-week-fill"></i>Work Shifts</h1>
    <a asp-action="Create" class="btn btn-custom-primary">
        <i class="bi bi-plus-lg me-1"></i><span class="d-none d-sm-inline">Add </span>Shift
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert-custom-success mb-4">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert-custom-danger mb-4">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
    </div>
}

@if (!Model.Any())
{
    <div class="alert-custom-info">
        <i class="bi bi-info-circle-fill me-2"></i>No shifts scheduled yet. Click "Add Shift" to create one.
    </div>
}
else
{
    <div class="table-responsive">
        <div class="table-wrapper">
            <table class="table table-custom mb-0">
                <thead>
                    <tr>
                        <th><i class="bi bi-person-fill me-1"></i>Employee</th>
                        <th class="d-none d-md-table-cell"><i class="bi bi-calendar-fill me-1"></i>Date</th>
                        <th><i class="bi bi-clock me-1"></i>Start</th>
                        <th><i class="bi bi-clock-fill me-1"></i>End</th>
                        <th class="d-none d-sm-table-cell"><i class="bi bi-hourglass-split me-1"></i>Duration</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var shift in Model)
                    {
                        <tr>
                            <td>
                                @if (shift.User != null)
                                {
                                    <strong style="color: #1e293b;">@shift.User.FirstName @shift.User.LastName</strong>
                                    <span class="d-block small" style="color: #64748b;">@shift.User.Email</span>
                                }
                                else
                                {
                                    <span style="color: #94a3b8;">Unknown User</span>
                                }
                            </td>
                            <td class="d-none d-md-table-cell">
                                <span class="badge-custom">@shift.StartTime.ToString("dddd")</span>
                                <span class="d-block small mt-1" style="color: #475569;">@shift.StartTime.ToString("dd MMM yyyy")</span>
                            </td>
                            <td>
                                <span class="badge-custom-success">@shift.StartTime.ToString("HH:mm")</span>
                            </td>
                            <td>
                                <span class="badge-custom-danger">@shift.EndTime.ToString("HH:mm")</span>
                            </td>
                            <td class="d-none d-sm-table-cell">
                                <span class="badge-custom-info">@shift.DurationHours.ToString("F1") hrs</span>
                            </td>
                            <td class="text-end" style="white-space: nowrap;">
                                <a asp-action="Details" asp-route-id="@shift.Id" class="btn btn-custom-info btn-custom-sm" title="Details">
                                    <i class="bi bi-eye-fill"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@shift.Id" method="post" class="d-inline" 
                                      onsubmit="return confirm('Are you sure you want to delete this shift?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-custom-danger btn-custom-sm" title="Delete">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    <div class="mt-3" style="color: #64748b;">
        <small><i class="bi bi-info-circle me-1"></i>Total shifts: @Model.Count()</small>
    </div>
}

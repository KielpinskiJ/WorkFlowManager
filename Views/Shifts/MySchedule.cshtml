@model IEnumerable<WorkFlowManager.Models.WorkShift>

@{
    ViewData["Title"] = "My Schedule";
    var weekStart = (DateTime)ViewBag.WeekStart;
    var weekEnd = (DateTime)ViewBag.WeekEnd;
    var userName = (string)ViewBag.UserName;
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-calendar-check-fill"></i>My Schedule</h1>
        <p class="mb-0" style="color: #64748b;">
            <i class="bi bi-person-circle me-1"></i>@userName
        </p>
    </div>
    <span class="badge-custom-info" style="font-size: 1rem;">
        <i class="bi bi-calendar-range me-1"></i>
        @weekStart.ToString("dd MMM") - @weekEnd.ToString("dd MMM yyyy")
    </span>
</div>

@if (!Model.Any())
{
    <div class="alert-custom-info">
        <i class="bi bi-info-circle-fill me-2"></i>
        <strong>No shifts scheduled this week.</strong>
        <p class="mb-0 mt-2">You don't have any work shifts assigned for the current week. 
        Contact your manager if you believe this is an error.</p>
    </div>
}
else
{
    <div class="row">
        @foreach (var shift in Model.OrderBy(s => s.StartTime))
        {
            var isToday = shift.StartTime.Date == DateTime.Today;
            var isPast = shift.EndTime < DateTime.Now;
            
            <div class="col-md-6 col-lg-4 mb-3">
                <div class="card-custom @(isToday ? "border-primary border-2" : "") @(isPast ? "opacity-75" : "")">
                    <div class="card-header @(isToday ? "bg-primary text-white" : "")">
                        <div class="d-flex justify-content-between align-items-center">
                            <strong>
                                <i class="bi bi-calendar-day me-1"></i>
                                @shift.StartTime.ToString("dddd")
                            </strong>
                            @if (isToday)
                            {
                                <span class="badge-custom-warning">Today</span>
                            }
                            else if (isPast)
                            {
                                <span class="badge-custom">Completed</span>
                            }
                            else
                            {
                                <span class="badge-custom-success">Upcoming</span>
                            }
                        </div>
                        <small class="@(isToday ? "opacity-75" : "")" style="color: @(isToday ? "#fff" : "#64748b");">
                            @shift.StartTime.ToString("dd MMMM yyyy")
                        </small>
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-5">
                                <div style="color: #22c55e;">
                                    <i class="bi bi-box-arrow-in-right fs-4"></i>
                                </div>
                                <div class="fw-bold fs-5" style="color: #1e293b;">@shift.StartTime.ToString("HH:mm")</div>
                                <small style="color: #64748b;">Start</small>
                            </div>
                            <div class="col-2 d-flex align-items-center justify-content-center">
                                <i class="bi bi-arrow-right" style="color: #94a3b8;"></i>
                            </div>
                            <div class="col-5">
                                <div style="color: #ef4444;">
                                    <i class="bi bi-box-arrow-right fs-4"></i>
                                </div>
                                <div class="fw-bold fs-5" style="color: #1e293b;">@shift.EndTime.ToString("HH:mm")</div>
                                <small style="color: #64748b;">End</small>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer d-flex justify-content-between align-items-center">
                        <span style="color: #64748b;">
                            <i class="bi bi-clock-history me-1"></i>Duration
                        </span>
                        <span class="badge-custom-info">@shift.DurationHours.ToString("F1") hours</span>
                    </div>
                </div>
            </div>
        }
    </div>
    
    <hr class="my-4" style="border-color: #e2e8f0;" />
    
    <div class="card-custom">
        <div class="card-body">
            <div class="row text-center">
                <div class="col-md-4 mb-3 mb-md-0">
                    <h5 style="color: #64748b;" class="mb-1">Total Shifts</h5>
                    <span class="fs-3 fw-bold" style="color: #3b82f6;">@Model.Count()</span>
                </div>
                <div class="col-md-4 mb-3 mb-md-0">
                    <h5 style="color: #64748b;" class="mb-1">Total Hours</h5>
                    <span class="fs-3 fw-bold" style="color: #22c55e;">@Model.Sum(s => s.DurationHours).ToString("F1")</span>
                </div>
                <div class="col-md-4">
                    <h5 style="color: #64748b;" class="mb-1">Avg. Shift Length</h5>
                    <span class="fs-3 fw-bold" style="color: #0ea5e9;">@Model.Average(s => s.DurationHours).ToString("F1") hrs</span>
                </div>
            </div>
        </div>
    </div>
}

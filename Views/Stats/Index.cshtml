@model IEnumerable<WorkFlowManager.ViewModels.DepartmentStatsDto>

@{
    ViewData["Title"] = "Statistics Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1><i class="bi bi-bar-chart-line me-2"></i>Statistics Dashboard</h1>
        <p class="text-muted mb-0">Work hours by department (last 3 months)</p>
    </div>
    <span class="badge bg-info fs-6">
        <i class="bi bi-calendar3 me-1"></i>
        Last 3 months
    </span>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        <strong>No data available.</strong>
        <p class="mb-0 mt-2">There are no shifts recorded in the last 3 months, or users don't have departments assigned.</p>
    </div>
}
else
{
    <div class="row">
        <!-- Chart Section -->
        <div class="col-lg-8 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-bar-chart-fill me-2"></i>Hours by Department</h5>
                </div>
                <div class="card-body">
                    <canvas id="departmentChart" height="300"></canvas>
                </div>
            </div>
        </div>
        
        <!-- Summary Cards -->
        <div class="col-lg-4 mb-4">
            <div class="card shadow-sm mb-3 bg-primary text-white">
                <div class="card-body text-center">
                    <i class="bi bi-clock-history fs-1 mb-2"></i>
                    <h3 class="mb-0">@Model.Sum(s => s.TotalHours).ToString("F1")</h3>
                    <small>Total Hours Worked</small>
                </div>
            </div>
            
            <div class="card shadow-sm mb-3 bg-success text-white">
                <div class="card-body text-center">
                    <i class="bi bi-calendar-check fs-1 mb-2"></i>
                    <h3 class="mb-0">@Model.Sum(s => s.ShiftCount)</h3>
                    <small>Total Shifts</small>
                </div>
            </div>
            
            <div class="card shadow-sm bg-info text-white">
                <div class="card-body text-center">
                    <i class="bi bi-building fs-1 mb-2"></i>
                    <h3 class="mb-0">@Model.Count()</h3>
                    <small>Active Departments</small>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Data Table -->
    <div class="card shadow-sm">
        <div class="card-header bg-secondary text-dark">
            <h5 class="mb-0"><i class="bi bi-table me-2"></i>Detailed Statistics</h5>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Department</th>
                        <th class="text-end">Total Hours</th>
                        <th class="text-end">Shift Count</th>
                        <th class="text-end">Avg. Shift Length</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var rank = 1;
                    }
                    @foreach (var stat in Model)
                    {
                        var avgHours = stat.ShiftCount > 0 ? stat.TotalHours / stat.ShiftCount : 0;
                        <tr>
                            <td>
                                @if (rank == 1)
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-trophy"></i> @rank</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@rank</span>
                                }
                            </td>
                            <td class="fw-medium">@stat.DepartmentName</td>
                            <td class="text-end">
                                <span class="badge bg-primary fs-6">@stat.TotalHours.ToString("F1") hrs</span>
                            </td>
                            <td class="text-end">@stat.ShiftCount</td>
                            <td class="text-end">
                                <span class="text-muted">@avgHours.ToString("F1") hrs</span>
                            </td>
                        </tr>
                        rank++;
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr class="fw-bold">
                        <td colspan="2">TOTAL</td>
                        <td class="text-end">@Model.Sum(s => s.TotalHours).ToString("F1") hrs</td>
                        <td class="text-end">@Model.Sum(s => s.ShiftCount)</td>
                        <td class="text-end">-</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
    
}

@section Scripts {
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    
    <script>
        // Data from controller (serialized as JSON)
        const labels = @Html.Raw(ViewBag.ChartLabels ?? "[]");
        const hoursData = @Html.Raw(ViewBag.ChartHours ?? "[]");
        const countsData = @Html.Raw(ViewBag.ChartCounts ?? "[]");
        
        // Create the chart
        const ctx = document.getElementById('departmentChart');
        
        if (ctx && labels.length > 0) {
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Total Hours',
                        data: hoursData,
                        backgroundColor: [
                            'rgba(54, 162, 235, 0.8)',
                            'rgba(255, 99, 132, 0.8)',
                            'rgba(75, 192, 192, 0.8)',
                            'rgba(255, 206, 86, 0.8)',
                            'rgba(153, 102, 255, 0.8)',
                            'rgba(255, 159, 64, 0.8)'
                        ],
                        borderColor: [
                            'rgba(54, 162, 235, 1)',
                            'rgba(255, 99, 132, 1)',
                            'rgba(75, 192, 192, 1)',
                            'rgba(255, 206, 86, 1)',
                            'rgba(153, 102, 255, 1)',
                            'rgba(255, 159, 64, 1)'
                        ],
                        borderWidth: 2,
                        borderRadius: 5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        },
                        title: {
                            display: true,
                            text: 'Work Hours by Department (Last 3 Months)',
                            font: {
                                size: 16
                            }
                        },
                        tooltip: {
                            callbacks: {
                                afterLabel: function(context) {
                                    const index = context.dataIndex;
                                    return 'Shifts: ' + countsData[index];
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Hours'
                            }
                        },
                        x: {
                            title: {
                                display: true,
                                text: 'Department'
                            }
                        }
                    }
                }
            });
        }
    </script>
}


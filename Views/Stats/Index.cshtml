@model IEnumerable<WorkFlowManager.ViewModels.DepartmentStatsDto>

@{
    ViewData["Title"] = "Statistics Dashboard";
    var selectedMonths = (int)(ViewBag.SelectedMonths ?? 3);
    var periodLabel = selectedMonths switch
    {
        1 => "Last month",
        3 => "Last 3 months",
        6 => "Last 6 months",
        12 => "Last 12 months",
        _ => $"Last {selectedMonths} months"
    };
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-bar-chart-line-fill"></i>Statistics Dashboard</h1>
        <p class="mb-0" style="color: #64748b;">Work hours by department (@periodLabel.ToLower())</p>
    </div>
    <form method="get" class="d-inline-block">
        <div class="d-flex align-items-center" style="background-color: #3b82f6; border-radius: 0.375rem; padding-left: 0.75rem;">
            <i class="bi bi-calendar3" style="color: white;"></i>
            <select name="months" class="form-select border-0" 
                    style="background-color: #3b82f6; color: white; font-weight: 500; padding: 0.5rem 2rem 0.5rem 0.5rem; cursor: pointer;"
                    onchange="this.form.submit()">
                <option value="1" selected="@(selectedMonths == 1)" style="background: white; color: #1e293b;">Last month</option>
                <option value="3" selected="@(selectedMonths == 3)" style="background: white; color: #1e293b;">Last 3 months</option>
                <option value="6" selected="@(selectedMonths == 6)" style="background: white; color: #1e293b;">Last 6 months</option>
                <option value="12" selected="@(selectedMonths == 12)" style="background: white; color: #1e293b;">Last 12 months</option>
            </select>
        </div>
        <noscript><button type="submit" class="btn btn-sm btn-light ms-1">Go</button></noscript>
    </form>
</div>

@if (!Model.Any())
{
    <div class="alert-custom-info">
        <i class="bi bi-info-circle-fill me-2"></i>
        <strong>No data available.</strong>
        <p class="mb-0 mt-2">There are no shifts recorded in the @periodLabel.ToLower(), or users don't have departments assigned.</p>
    </div>
}
else
{
    <div class="row">
        <!-- Chart Section -->
        <div class="col-lg-8 mb-4">
            <div class="card-custom">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-bar-chart-fill me-2"></i>Hours by Department</h5>
                </div>
                <div class="card-body">
                    <canvas id="departmentChart" height="300"></canvas>
                </div>
            </div>
        </div>
        
        <!-- Summary Cards -->
        <div class="col-lg-4 mb-4">
            <div class="card-custom card-highlight mb-3" style="background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);">
                <div class="card-body text-center text-white py-3">
                    <i class="bi bi-clock-history fs-1 mb-2"></i>
                    <h3 class="mb-0">@Model.Sum(s => s.TotalHours).ToString("F1")</h3>
                    <small class="opacity-75">Total Hours Worked</small>
                </div>
            </div>
            
            <div class="card-custom card-highlight mb-3" style="background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);">
                <div class="card-body text-center text-white py-3">
                    <i class="bi bi-calendar-check fs-1 mb-2"></i>
                    <h3 class="mb-0">@Model.Sum(s => s.ShiftCount)</h3>
                    <small class="opacity-75">Total Shifts</small>
                </div>
            </div>
            
            <div class="card-custom card-highlight" style="background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);">
                <div class="card-body text-center text-white py-3">
                    <i class="bi bi-building fs-1 mb-2"></i>
                    <h3 class="mb-0">@Model.Count()</h3>
                    <small class="opacity-75">Active Departments</small>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Data Table -->
    <div class="card-custom mb-5">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-table me-2"></i>Detailed Statistics</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <div class="table-wrapper">
                    <table class="table table-custom mb-0">
                        <thead>
                            <tr>
                                <th><i class="bi bi-hash me-1"></i>#</th>
                                <th><i class="bi bi-building-fill me-1"></i>Department</th>
                                <th class="text-end"><i class="bi bi-clock me-1"></i>Hours</th>
                                <th class="text-end d-none d-md-table-cell"><i class="bi bi-calendar-check me-1"></i>Shifts</th>
                                <th class="text-end d-none d-md-table-cell"><i class="bi bi-graph-up me-1"></i>Avg.</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var rank = 1;
                            }
                            @foreach (var stat in Model)
                            {
                                var avgHours = stat.ShiftCount > 0 ? stat.TotalHours / stat.ShiftCount : 0;
                                <tr>
                                    <td>
                                        @if (rank == 1)
                                        {
                                            <span class="badge-custom-warning"><i class="bi bi-trophy-fill"></i> @rank</span>
                                        }
                                        else
                                        {
                                            <span class="badge-custom">@rank</span>
                                        }
                                    </td>
                                    <td><strong style="color: #1e293b;">@stat.DepartmentName</strong></td>
                                    <td class="text-end">
                                        <span class="badge-custom-info">@stat.TotalHours.ToString("F1") hrs</span>
                                    </td>
                                    <td class="text-end d-none d-md-table-cell" style="color: #475569;">@stat.ShiftCount</td>
                                    <td class="text-end d-none d-md-table-cell" style="color: #64748b;">@avgHours.ToString("F1") hrs</td>
                                </tr>
                                rank++;
                            }
                        </tbody>
                        <tfoot>
                            <tr style="background: #f8fafc;">
                                <th colspan="2" style="color: #1e293b;">TOTAL</th>
                                <th class="text-end" style="color: #1e293b;">@Model.Sum(s => s.TotalHours).ToString("F1") hrs</th>
                                <th class="text-end d-none d-md-table-cell" style="color: #1e293b;">@Model.Sum(s => s.ShiftCount)</th>
                                <th class="text-end d-none d-md-table-cell" style="color: #64748b;">-</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    
    <script>
        // Data from controller (serialized as JSON)
        const labels = @Html.Raw(ViewBag.ChartLabels ?? "[]");
        const hoursData = @Html.Raw(ViewBag.ChartHours ?? "[]");
        const countsData = @Html.Raw(ViewBag.ChartCounts ?? "[]");
        const periodLabel = '@periodLabel';
        
        // Create the chart
        const ctx = document.getElementById('departmentChart');
        
        if (ctx && labels.length > 0) {
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Total Hours',
                        data: hoursData,
                        backgroundColor: [
                            'rgba(59, 130, 246, 0.8)',
                            'rgba(34, 197, 94, 0.8)',
                            'rgba(14, 165, 233, 0.8)',
                            'rgba(245, 158, 11, 0.8)',
                            'rgba(168, 85, 247, 0.8)',
                            'rgba(236, 72, 153, 0.8)'
                        ],
                        borderColor: [
                            'rgba(59, 130, 246, 1)',
                            'rgba(34, 197, 94, 1)',
                            'rgba(14, 165, 233, 1)',
                            'rgba(245, 158, 11, 1)',
                            'rgba(168, 85, 247, 1)',
                            'rgba(236, 72, 153, 1)'
                        ],
                        borderWidth: 2,
                        borderRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        },
                        title: {
                            display: true,
                            text: 'Work Hours by Department (' + periodLabel + ')',
                            font: {
                                size: 16,
                                weight: 'bold'
                            },
                            color: '#1e293b'
                        },
                        tooltip: {
                            callbacks: {
                                afterLabel: function(context) {
                                    const index = context.dataIndex;
                                    return 'Shifts: ' + countsData[index];
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Hours',
                                color: '#64748b'
                            },
                            ticks: {
                                color: '#64748b'
                            },
                            grid: {
                                color: '#e2e8f0'
                            }
                        },
                        x: {
                            title: {
                                display: true,
                                text: 'Department',
                                color: '#64748b'
                            },
                            ticks: {
                                color: '#64748b'
                            },
                            grid: {
                                color: '#e2e8f0'
                            }
                        }
                    }
                }
            });
        }
    </script>
}

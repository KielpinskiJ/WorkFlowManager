@model WorkFlowManager.ViewModels.UserEditViewModel

@{
    ViewData["Title"] = "Edit User";
}

<div class="page-header">
    <h1><i class="bi bi-person-gear"></i>Edit User</h1>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card-custom">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-person-fill me-2"></i>@Model.Email</h5>
            </div>
            <div class="card-body">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="alert-custom-danger mb-3" role="alert"></div>
                    
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Email" />
                    
                    <div class="mb-3">
                        <label asp-for="FirstName" class="form-label fw-semibold" style="color: #374151;">
                            <i class="bi bi-person-fill me-1" style="color: #3b82f6;"></i>First Name
                        </label>
                        <input asp-for="FirstName" class="form-control" />
                        <div class="form-text">Maximum 100 characters</div>
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="LastName" class="form-label fw-semibold" style="color: #374151;">
                            <i class="bi bi-person-fill me-1" style="color: #3b82f6;"></i>Last Name
                        </label>
                        <input asp-for="LastName" class="form-control" />
                        <div class="form-text">Maximum 100 characters</div>
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="DepartmentId" class="form-label fw-semibold" style="color: #374151;">
                            <i class="bi bi-building-fill me-1" style="color: #3b82f6;"></i>Department
                        </label>
                        <select asp-for="DepartmentId" asp-items="Model.Departments" class="form-select">
                            <option>-- Select Department --</option>
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                    </div>
                    
                    <div class="mb-4 form-check">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label" style="color: #374151;">Active</label>
                    </div>
                    
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-custom-primary">
                            <i class="bi bi-check-lg me-1"></i>Save Changes
                        </button>
                        <a asp-action="Index" class="btn btn-custom-secondary">
                            <i class="bi bi-x-lg me-1"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model IEnumerable<WorkFlowManager.ViewModels.UserListViewModel>

@{
    ViewData["Title"] = "User Management";
    var departments = (IEnumerable<WorkFlowManager.Models.Department>?)ViewBag.Departments ?? Enumerable.Empty<WorkFlowManager.Models.Department>();
    var selectedDepartmentId = (int?)ViewBag.SelectedDepartmentId;
    var selectedStatus = (string?)ViewBag.SelectedStatus;
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var hasFilters = selectedDepartmentId.HasValue || !string.IsNullOrEmpty(selectedStatus);
}

<div class="page-header">
    <h1><i class="bi bi-people-fill"></i>User Management</h1>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert-custom-success mb-4">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["Success"]
    </div>
}

<div class="card-custom mb-4">
    <div class="card-body py-3">
        <form method="get" class="row g-3 align-items-end">
            <!-- Department Filter -->
            <div class="col-md-4">
                <label class="form-label fw-semibold mb-1" style="color: #374151;">
                    <i class="bi bi-building me-1" style="color: #3b82f6;"></i>Department
                </label>
                <select name="departmentId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Departments</option>
                    <option value="0" selected="@(selectedDepartmentId == 0)">
                        <i class="bi bi-dash-circle"></i> Not Assigned
                    </option>
                    @foreach (var dept in departments)
                    {
                        <option value="@dept.Id" selected="@(selectedDepartmentId == dept.Id)">@dept.Name</option>
                    }
                </select>
            </div>
            
            <div class="col-md-4">
                <label class="form-label fw-semibold mb-1" style="color: #374151;">
                    <i class="bi bi-toggle-on me-1" style="color: #3b82f6;"></i>Status
                </label>
                <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    <option value="active" selected="@(selectedStatus == "active")">Active</option>
                    <option value="inactive" selected="@(selectedStatus == "inactive")">Inactive</option>
                </select>
            </div>
            
            <div class="col-md-4">
                <div class="d-flex gap-2 align-items-center">
                    @if (hasFilters)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-x-circle me-1"></i>Clear Filters
                        </a>
                    }
                    <span class="text-muted small ms-auto">
                        <i class="bi bi-people me-1"></i><strong>@totalCount</strong> user@(totalCount != 1 ? "s" : "")
                        @if (hasFilters)
                        {
                            <span class="ms-1">(filtered)</span>
                        }
                    </span>
                    <noscript>
                        <button type="submit" class="btn btn-custom-primary btn-sm">
                            <i class="bi bi-funnel me-1"></i>Apply
                        </button>
                    </noscript>
                </div>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert-custom-info">
        <i class="bi bi-info-circle-fill me-2"></i>
        @if (hasFilters)
        {
            <strong>No users match your filters.</strong>
            <p class="mb-0 mt-2">
                <a asp-action="Index">Clear filters</a> to see all users.
            </p>
        }
        else
        {
            <strong>No users found.</strong>
        }
    </div>
}
else
{
    <div class="table-responsive">
        <div class="table-wrapper">
            <table class="table table-custom mb-0">
                <thead>
                    <tr>
                        <th><i class="bi bi-person-fill me-1"></i>Name</th>
                        <th class="d-none d-md-table-cell"><i class="bi bi-envelope-fill me-1"></i>Email</th>
                        <th><i class="bi bi-building-fill me-1"></i>Department</th>
                        <th class="d-none d-lg-table-cell"><i class="bi bi-shield-fill me-1"></i>Roles</th>
                        <th class="d-none d-sm-table-cell"><i class="bi bi-toggle-on me-1"></i>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr class="@(!user.IsActive ? "opacity-75" : "")">
                            <td>
                                <strong style="color: #1e293b;">@user.FullName</strong>
                                <span class="d-md-none d-block small" style="color: #64748b;">@user.Email</span>
                            </td>
                            <td class="d-none d-md-table-cell" style="color: #475569;">@user.Email</td>
                            <td>
                                @if (!string.IsNullOrEmpty(user.DepartmentName))
                                {
                                    <span class="badge-custom-info">@user.DepartmentName</span>
                                }
                                else
                                {
                                    <span style="color: #94a3b8;">Not assigned</span>
                                }
                            </td>
                            <td class="d-none d-lg-table-cell">
                                @foreach (var role in user.Roles)
                                {
                                    @if (role == "Admin")
                                    {
                                        <span class="badge-custom-danger">@role</span>
                                    }
                                    else
                                    {
                                        <span class="badge-custom">@role</span>
                                    }
                                }
                            </td>
                            <td class="d-none d-sm-table-cell">
                                @if (user.IsActive)
                                {
                                    <span class="badge-custom-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge-custom-warning">Inactive</span>
                                }
                            </td>
                            <td class="text-end" style="white-space: nowrap;">
                                <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-custom-warning btn-custom-sm" title="Edit">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
